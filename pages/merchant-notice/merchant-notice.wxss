.page {
  min-height: 100vh;
  background: #F7F5EF;
  padding-bottom: 50rpx;
}

.page-header {
  height: 96rpx;
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.back-btn {
  width: 64rpx;
  font-size: 56rpx;
  line-height: 1;
  color: #173C34;
}

.page-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #173C34;
}

.top-action {
  padding: 10rpx 28rpx 24rpx;
}

.publish-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  background: #1F6A57;
  color: #FFFFFF;
  font-size: 28rpx;
}

.publish-btn::after {
  border: none;
}

.form-card {
  margin: 0 28rpx 28rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #173C34;
  margin-bottom: 26rpx;
}

.form-label {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #42534C;
}

.form-input {
  height: 82rpx;
  padding: 0 22rpx;
  background: #F7F5EF;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #173C34;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 22rpx;
  background: #F7F5EF;
  border-radius: 14rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.7;
  color: #173C34;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.form-actions button {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.form-actions button::after {
  border: none;
}

.cancel-btn {
  background: #F0F0EC;
  color: #59645F;
}

.submit-btn {
  background: #1F6A57;
  color: #FFFFFF;
}

.notice-list {
  padding: 0 28rpx;
}

.list-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #173C34;
  margin-bottom: 18rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-top {
  display: flex;
  align-items: center;
}

.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: #173C34;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-type {
  margin-left: 16rpx;
  padding: 7rpx 14rpx;
  background: #E7F2ED;
  color: #1F6A57;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.notice-content {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6D7772;
  line-height: 1.55;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.notice-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #A0A09A;
  font-size: 21rpx;
}

.delete-btn {
  margin-left: 20rpx;
  padding: 14rpx 12rpx;
  color: #C85C48;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding-top: 150rpx;
  color: #999;
  font-size: 27rpx;
}