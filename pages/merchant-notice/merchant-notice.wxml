<view class="page">

<!-- 顶部 -->
<view class="page-header">

  <view
    class="back-btn"
    bindtap="goBack"
  >
    ‹
  </view>

  <view class="page-title">
    公告管理
  </view>

</view>


<!-- 发布按钮 -->
<view class="top-action">
  <button
    class="publish-btn"
    bindtap="openForm"
  >
    ＋ 发布公告
  </button>
</view>


<!-- 发布表单 -->
<view
  wx:if="{{showForm}}"
  class="form-card"
>

  <view class="form-title">
    发布新公告
  </view>

  <view class="form-label">
    公告标题
  </view>

  <input
    class="form-input"
    placeholder="请输入公告标题"
    value="{{title}}"
    bindinput="inputTitle"
  />

  <view class="form-label">
    公告类型
  </view>

  <input
    class="form-input"
    placeholder="例如：通知、新品、活动"
    value="{{type}}"
    bindinput="inputType"
  />

  <view class="form-label">
    公告内容
  </view>

  <textarea
    class="form-textarea"
    placeholder="请输入公告内容"
    value="{{content}}"
    maxlength="1000"
    bindinput="inputContent"
  />

  <view class="form-actions">

    <button
      class="cancel-btn"
      bindtap="closeForm"
    >
      取消
    </button>

    <button
      class="submit-btn"
      bindtap="publishNotice"
    >
      发布
    </button>

  </view>

</view>


<!-- 公告列表 -->
<view class="notice-list">

  <view class="list-title">
    已发布公告
  </view>

  <block
    wx:for="{{notices}}"
    wx:key="id"
  >

    <view class="notice-item">

      <view
        class="notice-main"
        data-id="{{item.id}}"
        bindtap="openDetail"
      >

        <view class="notice-top">

          <view class="notice-title">
            {{item.title}}
          </view>

          <view class="notice-type">
            {{item.type}}
          </view>

        </view>

        <view class="notice-content">
          {{item.content}}
        </view>

        <view class="notice-meta">
          <text>{{item.author}}</text>
          <text>{{item.time}}</text>
        </view>

      </view>


      <view
        class="delete-btn"
        data-id="{{item.id}}"
        catchtap="deleteNotice"
      >
        删除
      </view>

    </view>

  </block>


  <view
    wx:if="{{notices.length === 0}}"
    class="empty"
  >
    暂无公告
  </view>

</view>

</view>