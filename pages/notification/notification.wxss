page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}


/* =========================
   顶部
========================= */

.header {
  height: 110rpx;

  padding: 0 30rpx;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #173C34;
}

.read-all {
  font-size: 23rpx;
  color: #1F6A57;
}


/* =========================
   未读提示
========================= */

.notice-summary {
  margin: 0 28rpx 18rpx;

  padding: 20rpx 24rpx;

  border-radius: 18rpx;

  background: #EEF7F3;

  color: #1F6A57;

  font-size: 24rpx;
}


/* =========================
   通知列表
========================= */

.notification-list {
  padding: 0 20rpx;
}

.notification-item {
  position: relative;

  display: flex;
  align-items: flex-start;

  padding: 25rpx 18rpx;
  margin-bottom: 14rpx;

  border-radius: 20rpx;

  background: #FFFFFF;

  box-sizing: border-box;
}

.notification-item.unread {
  background: #FFFFFF;
}

.notification-item.read {
  opacity: 0.72;
}


/* 图标 */

.notification-icon {
  width: 70rpx;
  height: 70rpx;

  flex-shrink: 0;

  border-radius: 20rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 32rpx;
}

.merchant-icon {
  background: #EAF5F0;
}

.comment-icon {
  background: #EEF3F8;
}

.poll-icon {
  background: #F3EDFB;
}

.order-icon {
  background: #FFF0E8;
}


/* 内容 */

.notification-main {
  flex: 1;

  margin-left: 18rpx;

  min-width: 0;
}

.notification-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.notification-title {
  flex: 1;

  font-size: 28rpx;
  font-weight: 600;

  color: #173C34;

  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notification-time {
  margin-left: 15rpx;

  font-size: 20rpx;
  color: #A1AAA6;
}

.notification-content {
  margin-top: 9rpx;

  font-size: 24rpx;
  line-height: 1.6;

  color: #718079;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  overflow: hidden;
}


/* 未读点 */

.unread-dot {
  position: absolute;

  right: 16rpx;
  top: 16rpx;

  width: 14rpx;
  height: 14rpx;

  border-radius: 50%;

  background: #DF6A43;
}


/* =========================
   空状态
========================= */

.empty {
  text-align: center;
  padding-top: 190rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  margin-top: 20rpx;

  font-size: 30rpx;
  font-weight: 600;

  color: #173C34;
}

.empty-text {
  margin-top: 10rpx;

  font-size: 23rpx;

  color: #99A49F;
}