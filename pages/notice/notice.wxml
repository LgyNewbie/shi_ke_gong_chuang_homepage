<view class="page">

<!-- 顶部 -->
<view class="header">
  <view class="header-title">餐厅公告</view>
  <view class="header-subtitle">及时了解餐厅最新消息</view>
</view>

<!-- 分类 -->
<scroll-view class="category-scroll" scroll-x>
  <view class="category-list">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="category {{currentCategory === item ? 'active' : ''}}"
      data-category="{{item}}"
      bindtap="changeCategory"
    >
      {{item}}
    </view>
  </view>
</scroll-view>

<!-- 公告列表 -->
<view class="notice-list">

  <view
    wx:for="{{filteredNotices}}"
    wx:key="id"
    class="notice-card {{item.pinned ? 'pinned-card' : ''}}"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >

    <!-- 置顶 -->
    <view wx:if="{{item.pinned}}" class="pinned-label">
      置顶公告
    </view>

    <view class="notice-top">
      <view class="notice-tag {{item.typeClass}}">
        {{item.type}}
      </view>

      <view class="notice-date">
        {{item.date}}
      </view>
    </view>

    <view class="notice-title">
      {{item.title}}
    </view>

    <view class="notice-summary">
      {{item.summary}}
    </view>

    <view class="notice-bottom">
      <text>查看详情</text>
      <text class="arrow">›</text>
    </view>

  </view>

</view>

<!-- 空状态 -->
<view wx:if="{{filteredNotices.length === 0}}" class="empty">
  <view class="empty-icon">📢</view>
  <view class="empty-title">暂无相关公告</view>
  <view class="empty-text">换个分类看看吧</view>
</view>

</view>