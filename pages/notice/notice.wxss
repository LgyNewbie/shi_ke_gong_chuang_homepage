.page {
  min-height: 100vh;
  background: #F7F5EF;
  padding-bottom: 40rpx;
}

.page-header {
  height: 96rpx;
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 32rpx;
  background: #F7F5EF;
}

.back-btn {
  width: 64rpx;
  font-size: 56rpx;
  line-height: 1;
  color: #173C34;
}

.page-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #173C34;
}

.notice-list {
  padding: 20rpx 28rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.notice-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #173C34;
}

.notice-type {
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #E7F2ED;
  color: #1F6A57;
  font-size: 22rpx;
}

.notice-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #66736E;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.notice-bottom {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #9A9A94;
}

.notice-arrow {
  margin-left: 20rpx;
  font-size: 42rpx;
  color: #9AA59F;
}

.empty {
  text-align: center;
  padding-top: 180rpx;
  color: #999;
  font-size: 28rpx;
}