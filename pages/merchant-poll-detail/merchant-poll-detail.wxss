.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #F7F5EF;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 52rpx;
  color: #173C34;
  margin-right: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #173C34;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #7B8B85;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 30rpx rgba(23, 60, 52, 0.06);
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.status-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F3EE;
  color: #1F6A57;
  font-size: 24rpx;
}

.create-time {
  font-size: 22rpx;
  color: #8A9691;
}

.poll-title {
  font-size: 38rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #173C34;
}

.poll-description {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #687873;
}

.source-box {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #F6F8F6;
  border-radius: 18rpx;
}

.source-label {
  font-size: 24rpx;
  color: #1F6A57;
  font-weight: 700;
}

.source-text {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #173C34;
}

.source-user {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #788681;
}

.source-status {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #788681;
}

.info-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.info-item {
  flex: 1;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #F8F6F1;
}

.info-label {
  font-size: 23rpx;
  color: #7D8A85;
}

.info-value {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #173C34;
}

.date-row {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #6F7D78;
}

.section-title {
  margin-top: 34rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #173C34;
}

.result-item {
  margin-bottom: 26rpx;
}

.result-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.result-name-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.result-name {
  font-size: 28rpx;
  color: #173C34;
}

.result-number {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #1F6A57;
}

.result-percent {
  font-weight: 700;
}

.progress-bg {
  width: 100%;
  height: 18rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #E7ECE9;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #1F6A57;
}

.winner-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #FFF3D8;
  color: #A56800;
  font-size: 22rpx;
}

.winner-box {
  margin-top: 30rpx;
  padding: 26rpx;
  text-align: center;
  background: #F8F6F1;
  border-radius: 20rpx;
}

.winner-label {
  font-size: 23rpx;
  color: #7D8A85;
}

.winner-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #173C34;
}

.winner-subtitle {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #A56800;
}

.state-box {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #F6F8F6;
}

.state-title {
  font-size: 23rpx;
  color: #7D8A85;
}

.state-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F6A57;
}

.back-button {
  margin: 28rpx 0 40rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #1F6A57;
  color: #FFFFFF;
  font-size: 28rpx;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #173C34;
}