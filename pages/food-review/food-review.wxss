.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 140rpx;
}

/* 顶部 */
.header {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.back {
  width: 60rpx;
  font-size: 56rpx;
  line-height: 60rpx;
  color: #333333;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #222222;
}

.header-placeholder {
  width: 60rpx;
}

/* 卡片 */
.card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-sizing: border-box;
}

/* 商品信息 */
.food-card {
  display: flex;
  align-items: center;
}

.food-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #f1f1f1;
  flex-shrink: 0;
}

.food-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.food-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 18rpx;
}

.food-price {
  display: block;
  font-size: 28rpx;
  color: #e85d04;
}

/* 标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}

/* 评分 */
.rating-card {
  text-align: center;
}

.rating-stars {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30rpx;
}

.star {
  margin: 0 10rpx;
  font-size: 60rpx;
  color: #dddddd;
  line-height: 1;
}

.star.active {
  color: #ffb300;
}

.rating-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #888888;
}

/* 评价内容 */
.content-card {
  position: relative;
}

.review-textarea {
  width: 100%;
  height: 280rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.word-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999999;
}

/* 底部提交 */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.submit-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #ff7a00;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.submit-button::after {
  border: none;
}