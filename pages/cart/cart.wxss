page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}


/* 顶部 */
.header {
  height: 120rpx;
  padding: 0 28rpx;

  display: flex;
  align-items: center;

  position: relative;
}

.back {
  width: 70rpx;

  font-size: 58rpx;
  color: #173C34;
}

.header-title {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 38rpx;
  color: #173C34;
  font-weight: bold;
}

.subtitle {
  margin-top: 5rpx;
  color: #8A9792;
  font-size: 20rpx;
}

.clear-cart {
  margin-left: auto;

  padding: 10rpx 20rpx;

  border-radius: 24rpx;

  background: #EDF2EF;
  color: #71827C;

  font-size: 20rpx;
}


/* 商品列表 */
.cart-list {
  padding: 0 24rpx;
}

.cart-item {
  position: relative;

  display: flex;

  padding: 22rpx;

  margin-bottom: 18rpx;

  border-radius: 28rpx;

  background: white;

  box-shadow: 0 8rpx 25rpx rgba(31, 70, 60, .05);
}

.food-image {
  width: 180rpx;
  height: 180rpx;

  flex-shrink: 0;

  border-radius: 22rpx;
}

.food-info {
  flex: 1;
  min-width: 0;

  margin-left: 18rpx;

  padding-right: 28rpx;
}

.food-name {
  color: #24483F;

  font-size: 28rpx;
  font-weight: bold;
}

.food-desc {
  margin-top: 8rpx;

  color: #8B9893;

  font-size: 20rpx;

  line-height: 1.5;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-bottom {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-top: 34rpx;
}

.price {
  color: #DF6A43;

  font-size: 32rpx;
  font-weight: bold;
}

.counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 50rpx;
  height: 50rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-size: 30rpx;
}

.minus {
  background: #EAF0ED;
  color: #1F6A57;
}

.plus {
  background: #1F6A57;
  color: white;
}

.count {
  min-width: 48rpx;

  text-align: center;

  color: #3A554B;

  font-size: 24rpx;
}

.delete {
  position: absolute;

  top: 18rpx;
  right: 20rpx;

  width: 42rpx;
  height: 42rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #F2F4F3;

  color: #87948F;

  font-size: 28rpx;
}


/* 空购物车 */
.empty {
  padding-top: 180rpx;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 90rpx;
}

.empty-title {
  margin-top: 25rpx;

  color: #3C574E;

  font-size: 29rpx;
  font-weight: bold;
}

.empty-text {
  margin-top: 10rpx;

  color: #95A19C;

  font-size: 21rpx;
}

.go-menu-btn {
  width: 260rpx;
  height: 78rpx;

  margin-top: 35rpx;

  line-height: 78rpx;

  border-radius: 40rpx;

  background: #1F6A57;

  color: white;

  font-size: 25rpx;
}


/* 摘要 */
.summary {
  margin: 24rpx 24rpx 0;

  padding: 26rpx;

  background: white;

  border-radius: 28rpx;
}

.summary-row {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 18rpx;

  color: #667A73;

  font-size: 22rpx;
}

.summary-line {
  height: 1rpx;

  margin: 8rpx 0 20rpx;

  background: #EDF0EE;
}

.total-row {
  margin-bottom: 0;
}

.total-row > text:first-child {
  color: #304C42;

  font-size: 27rpx;
  font-weight: bold;
}

.total-price {
  color: #DF6A43;

  font-size: 36rpx;
  font-weight: bold;
}


/* 底部 */
.bottom-bar {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 20;

  height: 110rpx;

  display: flex;

  align-items: center;
  justify-content: space-between;

  padding: 0 24rpx;

  background: rgba(255,255,255,.97);

  box-shadow: 0 -10rpx 28rpx rgba(31,70,60,.08);
}

.bottom-total {
  display: flex;
  align-items: baseline;
}

.bottom-label {
  color: #566C64;

  font-size: 21rpx;
}

.bottom-price {
  margin-left: 10rpx;

  color: #DF6A43;

  font-size: 37rpx;
  font-weight: bold;
}

.checkout-btn {
  width: 240rpx;
  height: 76rpx;

  margin: 0;

  line-height: 76rpx;

  border-radius: 40rpx;

  background: #1F6A57;
  color: white;

  font-size: 25rpx;
  font-weight: bold;
}

button::after {
  border: none;
}