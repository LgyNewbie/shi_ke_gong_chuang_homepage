<view class="page">

<!-- 顶部 -->
<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <view class="header-title">
    <text class="title">购物车</text>
    <text class="subtitle">共 {{cartCount}} 件商品</text>
  </view>

  <view
    wx:if="{{cartItems.length > 0}}"
    class="clear-cart"
    bindtap="clearCart"
  >
    清空
  </view>

</view>


<!-- 商品列表 -->
<view wx:if="{{cartItems.length > 0}}" class="cart-list">

  <view
    wx:for="{{cartItems}}"
    wx:key="id"
    class="cart-item"
  >

    <!-- 商品图片 -->
    <image
      class="food-image"
      src="{{item.image}}"
      mode="aspectFill"
    />


    <!-- 商品信息 -->
    <view class="food-info">

      <view class="food-name">
        {{item.name}}
      </view>

      <view class="food-desc">
        {{item.desc}}
      </view>

      <view class="item-bottom">

        <text class="price">
          ¥{{item.price}}
        </text>

        <view class="counter">

          <view
            class="counter-btn minus"
            data-id="{{item.id}}"
            bindtap="decrease"
          >
            −
          </view>

          <text class="count">
            {{item.count}}
          </text>

          <view
            class="counter-btn plus"
            data-id="{{item.id}}"
            bindtap="increase"
          >
            +
          </view>

        </view>

      </view>

    </view>


    <!-- 删除 -->
    <view
      class="delete"
      data-id="{{item.id}}"
      bindtap="deleteItem"
    >
      ×
    </view>

  </view>

</view>


<!-- 空购物车 -->
<view
  wx:if="{{cartItems.length === 0}}"
  class="empty"
>

  <text class="empty-icon">
    🛒
  </text>

  <text class="empty-title">
    购物车还是空的
  </text>

  <text class="empty-text">
    去点餐看看有没有喜欢的菜吧
  </text>

  <button
    class="go-menu-btn"
    bindtap="goMenu"
  >
    去点餐
  </button>

</view>


<!-- 价格摘要 -->
<view
  wx:if="{{cartItems.length > 0}}"
  class="summary"
>

  <view class="summary-row">
    <text>商品小计</text>
    <text>¥{{cartTotal}}</text>
  </view>

  <view class="summary-row">
    <text>配送费</text>
    <text>{{deliveryFee === 0 ? '免配送费' : '¥' + deliveryFee}}</text>
  </view>

  <view class="summary-line"></view>

  <view class="summary-row total-row">
    <text>合计</text>
    <text class="total-price">
      ¥{{finalTotal}}
    </text>
  </view>

</view>


<!-- 底部结算 -->
<view
  wx:if="{{cartItems.length > 0}}"
  class="bottom-bar"
>

  <view class="bottom-total">
    <text class="bottom-label">合计</text>
    <text class="bottom-price">
      ¥{{finalTotal}}
    </text>
  </view>

  <button
    class="checkout-btn"
    bindtap="goCheckout"
  >
    去结算
  </button>

</view>

</view>