<view class="page">

<!-- 顶部 -->
<view class="header">

  <view class="back" bindtap="goBack">
    ‹
  </view>

  <text class="title">写留言</text>

  <view class="publish-top" bindtap="publishMessage">
    发布
  </view>

</view>


<!-- 提示 -->
<view class="guide">
  <text class="guide-title">说说你对餐厅的想法 💡</text>
  <text class="guide-text">
    新品建议、菜品反馈、服务建议，都可以告诉我们～
  </text>
</view>


<!-- 留言类型 -->
<view class="card">

  <view class="card-title">
    留言类型
  </view>

  <view class="category-list">

    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category {{currentCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >
      {{item.name}}
    </view>

  </view>

</view>


<!-- 输入内容 -->
<view class="card content-card">

  <view class="card-title">
    留言内容
  </view>

  <textarea
    class="textarea"
    maxlength="500"
    placeholder="写下你的想法，让餐厅听见你的声音..."
    value="{{content}}"
    bindinput="onContentInput"
    auto-height
  ></textarea>

  <view class="word-count">
    {{content.length}} / 500
  </view>

</view>


<!-- 图片 -->
<view class="card">

  <view class="card-title image-title">
    <text>添加图片</text>
    <text class="image-tip">最多9张</text>
  </view>

  <view class="image-grid">

    <!-- 已选图片 -->
    <view
      wx:for="{{images}}"
      wx:key="*this"
      class="image-item"
    >

      <image
        class="preview-image"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="previewImage"
      />

      <view
        class="delete-image"
        data-index="{{index}}"
        catchtap="deleteImage"
      >
        ×
      </view>

    </view>


    <!-- 添加图片 -->
    <view
      wx:if="{{images.length < 9}}"
      class="add-image"
      bindtap="chooseImage"
    >
      <text class="add-icon">＋</text>
      <text>添加图片</text>
    </view>

  </view>

</view>


<!-- 工具栏 -->
<view class="card tools-card">

  <view
    class="tool"
    bindtap="toggleEmoji"
  >
    <text class="tool-icon">😊</text>
    <text>表情</text>
  </view>

  <view
    class="tool"
    bindtap="chooseImage"
  >
    <text class="tool-icon">🖼️</text>
    <text>图片</text>
  </view>

</view>


<!-- 表情面板 -->
<view
  wx:if="{{showEmoji}}"
  class="emoji-panel"
>

  <view
    wx:for="{{emojis}}"
    wx:key="*this"
    class="emoji"
    data-emoji="{{item}}"
    bindtap="chooseEmoji"
  >
    {{item}}
  </view>

</view>


<!-- 底部按钮 -->
<view class="bottom-area">

  <button
    class="publish-btn"
    bindtap="publishMessage"
  >
    发布留言
  </button>

  <text class="bottom-tip">
    发布后，其他食客和餐厅都可以看到
  </text>

</view>

</view>