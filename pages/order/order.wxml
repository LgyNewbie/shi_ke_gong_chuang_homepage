<view class="page">

<!-- 顶部 -->
<view class="header">

  <text class="title">
    我的订单
  </text>

  <text class="order-count">
    共 {{orders.length}} 笔订单
  </text>

</view>


<!-- 状态筛选 -->
<scroll-view
  class="tabs-scroll"
  scroll-x="true"
  show-scrollbar="false"
>

  <view class="tabs">

    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{currentTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </view>

  </view>

</scroll-view>


<!-- 订单列表 -->
<view class="order-list">

  <!-- 有订单 -->
  <block
    wx:if="{{filteredOrders.length > 0}}"
  >

    <view
      wx:for="{{filteredOrders}}"
      wx:key="id"
      class="order-card"
    >

      <!-- 订单顶部 -->
      <view class="order-header">

        <text class="order-time">
          {{item.createTime}}
        </text>

        <text class="order-status {{item.status}}">
          {{item.statusName}}
        </text>

      </view>


      <!-- 商品列表 -->
      <view class="items">

        <view
          wx:for="{{item.items}}"
          wx:for-item="food"
          wx:key="id"
          class="food-row"
        >

          <image
            class="food-image"
            src="{{food.image}}"
            mode="aspectFill"
          />

          <view class="food-info">

            <text class="food-name">
              {{food.name}}
            </text>

            <text class="food-desc">
              {{food.desc}}
            </text>

          </view>

          <view class="food-right">

            <text class="food-price">
              ¥{{food.price}}
            </text>

            <text class="food-count">
              ×{{food.count}}
            </text>

          </view>

        </view>

      </view>


      <!-- 订单底部信息 -->
      <!-- 订单金额 -->
<view class="order-footer">

<view class="footer-left">

  <text>
    共 {{item.itemCount}} 件
  </text>

  <text class="order-number">
    订单号 {{item.id}}
  </text>

</view>

<view class="footer-right">

  <text class="total-label">
    实付
  </text>

  <text class="total-price">
    ¥{{item.finalTotal}}
  </text>

</view>

</view>


<!-- 费用明细 -->
<view class="order-price-detail">

<view class="price-detail-row">

  <text>
    商品小计
  </text>

  <text>
    ¥{{item.cartTotal}}
  </text>

</view>


<view
  class="price-detail-row discount"
  wx:if="{{item.productDiscount > 0}}"
>

  <text>
    商品优惠
  </text>

  <text>
    -¥{{item.productDiscount}}
  </text>

</view>


<view
  class="price-detail-row discount"
  wx:if="{{item.couponDiscount > 0}}"
>

  <text>
    优惠券
  </text>

  <text>
    -¥{{item.couponDiscount}}
  </text>

</view>


<view class="price-detail-row">

  <text>
    打包费
  </text>

  <text>
    ¥{{item.packingFee}}
  </text>

</view>


<view class="price-detail-row">

  <text>
    配送费
  </text>

  <text wx:if="{{item.deliveryFee === 0}}">
    免配送费
  </text>

  <text wx:if="{{item.deliveryFee > 0}}">
    ¥{{item.deliveryFee}}
  </text>

</view>


<view class="payment-method">

  <text>
    支付方式
  </text>

  <text class="payment-method-value">
    {{item.paymentMethod}}
  </text>

</view>

</view>


      <!-- 操作按钮 -->
      <view class="order-actions">

        <!-- 待付款：去付款 -->
        <!-- 待付款 -->
<button
  wx:if="{{item.status === 'pending' && item.paymentStatus !== 'paid'}}"
  class="action-btn primary"
  bindtap="payOrder"
  data-id="{{item.id}}"
>
  去付款
</button>

<!-- 已付款，等待商家接单 -->
<view
  wx:if="{{item.status === 'pending' && item.paymentStatus === 'paid'}}"
  class="action-btn waiting-btn"
>
  待商家接单
</view>


        <!-- 待付款：取消订单 -->
        <button
          wx:if="{{item.status === 'pending'}}"
          class="action-btn cancel-btn"
          catchtap="cancelOrder"
          data-id="{{item.id}}"
        >
          取消订单
        </button>


        <!-- 已完成：再来一单 -->
        <button
          wx:if="{{item.status === 'completed'}}"
          class="action-btn"
          catchtap="reorder"
          data-id="{{item.id}}"
        >
          再来一单
        </button>


        <!-- 查看详情 -->
        <button
          class="action-btn"
          catchtap="openDetail"
          data-id="{{item.id}}"
        >
          查看详情
        </button>

      </view>

    </view>

  </block>


  <!-- 没有订单 -->
  <view
    wx:if="{{filteredOrders.length === 0}}"
    class="empty"
  >

    <text class="empty-icon">
      📋
    </text>

    <text class="empty-title">
      还没有订单
    </text>

    <text class="empty-text">
      去点餐，选择喜欢的美味吧
    </text>

    <button
      class="go-menu"
      bindtap="goMenu"
    >
      去点餐
    </button>

  </view>

</view>

</view>