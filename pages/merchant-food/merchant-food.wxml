<view class="page">

<!-- 顶部 -->
<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <view class="title">
    商品管理
  </view>

  <view
    class="add-button"
    bindtap="addFood"
  >
    ＋
  </view>

</view>


<!-- 商品筛选 -->
<view class="tabs">

  <view
    class="tab {{currentTab === 'all' ? 'active' : ''}}"
    data-tab="all"
    bindtap="selectTab"
  >
    全部
  </view>

  <view
    class="tab {{currentTab === 'on' ? 'active' : ''}}"
    data-tab="on"
    bindtap="selectTab"
  >
    已上架
  </view>

  <view
    class="tab {{currentTab === 'off' ? 'active' : ''}}"
    data-tab="off"
    bindtap="selectTab"
  >
    已下架
  </view>

</view>


<!-- 排序按钮 -->
<view class="sort-bar">

  <view
    wx:if="{{!sortMode}}"
    class="sort-button"
    bindtap="startSortMode"
  >
    ☷ 调整商品排序
  </view>

  <view
    wx:if="{{sortMode}}"
    class="sort-tip"
  >
    长按商品并上下拖动调整顺序
  </view>

  <view
    wx:if="{{sortMode}}"
    class="sort-done"
    bindtap="finishSort"
  >
    完成排序
  </view>

</view>


<!-- 商品列表 -->
<view class="food-list">

  <block
    wx:for="{{foods}}"
    wx:key="id"
    wx:if="{{currentTab === 'all' || (currentTab === 'on' && item.isOnSale !== false) || (currentTab === 'off' && item.isOnSale === false)}}"
  >

    <view
      class="food-card {{sortMode && currentTab === 'all' ? 'sort-card' : ''}} {{draggingId === item.id ? 'dragging' : ''}}"
      data-id="{{item.id}}"
      bindlongpress="startDrag"
      bindtouchmove="onDragMove"
      bindtouchend="endDrag"
    >

      <!-- 排序模式下的拖拽提示 -->
      <view
        wx:if="{{sortMode && currentTab === 'all'}}"
        class="drag-handle"
      >
        ☰
      </view>


      <!-- 商品图片 -->
      <image
        class="food-image"
        src="{{item.image}}"
        mode="aspectFill"
      />


      <!-- 商品信息 -->
      <view class="food-info">

        <view class="food-top">

          <view class="food-name">
            {{item.name}}
          </view>

          <view
            class="status {{item.isOnSale === false ? 'off' : 'on'}}"
          >
            {{item.isOnSale === false ? '已下架' : '已上架'}}
          </view>

        </view>


        <view class="food-desc">
          {{item.desc}}
        </view>


        <view class="food-meta">

          <view class="price">
            ¥{{item.price}}
          </view>

          <view class="sales">
            已售 {{item.sales || 0}}
          </view>

        </view>


        <!-- 正常模式操作 -->
        <view
          wx:if="{{!sortMode}}"
          class="actions"
        >

          <button
            class="edit-button"
            size="mini"
            data-id="{{item.id}}"
            bindtap="editFood"
          >
            编辑
          </button>

          <button
            class="sale-button {{item.isOnSale === false ? 'on-button' : 'off-button'}}"
            size="mini"
            data-id="{{item.id}}"
            bindtap="toggleSale"
          >
            {{item.isOnSale === false ? '重新上架' : '下架'}}
          </button>

        </view>


        <!-- 排序模式 -->
        <view
          wx:if="{{sortMode && currentTab === 'all'}}"
          class="sort-hint"
        >
          长按拖动调整位置
        </view>

      </view>

    </view>

  </block>


  <!-- 空状态 -->
  <view
    wx:if="{{foods.length === 0}}"
    class="empty"
  >
    暂无商品
  </view>

</view>


<!-- 新增商品 -->
<view
  wx:if="{{!sortMode}}"
  class="bottom-add"
  bindtap="addFood"
>
  ＋ 新增商品
</view>

</view>