page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}


/* 顶部 */

.header {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8E5DE;
}

.back {
  width: 70rpx;
  font-size: 56rpx;
  color: #333;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.header-placeholder {
  width: 70rpx;
}


/* 区块 */

.section {
  margin: 24rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}


/* 图片 */

.image-box {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #F1F1F1;
}

.food-image {
  width: 100%;
  height: 100%;
}

.change-image {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx;
  text-align: center;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
  font-size: 26rpx;
}


/* 表单 */

.form-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.column {
  display: block;
  padding: 22rpx 0;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #444;
}

.column .label {
  width: auto;
  margin-bottom: 18rpx;
}

.input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #222;
}

.price-input {
  flex: 1;
  display: flex;
  align-items: center;
  color: #DF6A43;
  font-size: 30rpx;
  font-weight: 700;
}

.price-field {
  margin-left: 8rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F7F7F7;
  font-size: 27rpx;
  line-height: 1.6;
}


/* 分类 */

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  background: #F2F2F2;
  color: #777;
  font-size: 25rpx;
}

.category-item.active {
  color: #FFFFFF;
  background: #1F6A57;
}


/* 底部 */

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx 30rpx;
  background: rgba(247, 245, 239, 0.96);
}

.save-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  color: #FFFFFF;
  background: #1F6A57;
  font-size: 30rpx;
  font-weight: 700;
}

.save-button::after {
  border: none;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.promotion-box {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff8ef;
  border-radius: 16rpx;
}

.discount-input {
  display: flex;
  align-items: center;
}

.discount-input .form-input {
  flex: 1;
}

.discount-input text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.promotion-tip {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #999999;
  line-height: 1.6;
}