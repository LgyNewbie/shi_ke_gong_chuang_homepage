page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}


/* 顶部 */
.header {
  height: 115rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.back {
  position: absolute;
  left: 28rpx;

  font-size: 58rpx;
  color: #173C34;
}

.title {
  color: #173C34;
  font-size: 36rpx;
  font-weight: bold;
}


/* 状态 */
.status-card {
  margin: 0 24rpx;

  padding: 28rpx;

  display: flex;
  align-items: center;

  border-radius: 28rpx;

  background: #1F6A57;

  box-shadow: 0 10rpx 30rpx rgba(31,106,87,.18);
}

.status-icon {
  width: 76rpx;
  height: 76rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.16);

  color: white;

  font-size: 37rpx;
}

.status-info {
  display: flex;
  flex-direction: column;

  margin-left: 20rpx;
}

.status-title {
  color: white;

  font-size: 31rpx;
  font-weight: bold;
}

.status-desc {
  margin-top: 7rpx;

  color: rgba(255,255,255,.75);

  font-size: 21rpx;
}


/* 卡片 */
.card {
  margin: 20rpx 24rpx 0;

  padding: 26rpx;

  border-radius: 28rpx;

  background: white;

  box-shadow: 0 8rpx 25rpx rgba(31,70,60,.04);
}

.card-title {
  color: #24483F;

  font-size: 27rpx;
  font-weight: bold;
}


/* 时间线 */
.timeline {
  margin-top: 28rpx;
}

.timeline-item {
  display: flex;
  min-height: 82rpx;
}

.timeline-left {
  width: 50rpx;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 36rpx;
  height: 36rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #E3E9E6;
  color: white;

  font-size: 17rpx;
}

.timeline-item.active .timeline-dot {
  background: #1F6A57;
}

.timeline-item.current .timeline-dot {
  width: 42rpx;
  height: 42rpx;

  box-shadow: 0 0 0 7rpx #E5F1EC;
}

.timeline-line {
  width: 3rpx;
  flex: 1;

  margin: 6rpx 0;

  background: #E6EBE8;
}

.timeline-line.line-active {
  background: #1F6A57;
}

.timeline-content {
  padding-left: 14rpx;
  padding-bottom: 18rpx;

  display: flex;
  flex-direction: column;
}

.timeline-name {
  color: #415B52;
  font-size: 23rpx;
}

.timeline-item.current .timeline-name {
  color: #1F6A57;
  font-weight: bold;
}

.timeline-time {
  margin-top: 5rpx;

  color: #9AA6A1;
  font-size: 18rpx;
}


/* 商品 */
.food-row {
  display: flex;
  align-items: center;

  margin-top: 22rpx;
  padding-bottom: 18rpx;

  border-bottom: 1rpx solid #EDF0EE;
}

.food-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.food-image {
  width: 110rpx;
  height: 110rpx;

  border-radius: 18rpx;
}

.food-info {
  flex: 1;

  margin-left: 16rpx;

  min-width: 0;
}

.food-name {
  display: block;

  color: #304B42;

  font-size: 24rpx;
  font-weight: bold;
}

.food-desc {
  display: block;

  margin-top: 6rpx;

  color: #96A29D;

  font-size: 18rpx;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;

  margin-left: 12rpx;
}

.food-count {
  color: #8A9892;
  font-size: 19rpx;
}

.food-price {
  margin-top: 6rpx;

  color: #DF6A43;

  font-size: 25rpx;
  font-weight: bold;
}


/* 配送 */
.info-row {
  display: flex;
  align-items: center;

  margin-top: 20rpx;
}

.info-icon {
  width: 64rpx;
  height: 64rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #EAF3EE;

  font-size: 29rpx;
}

.info-content {
  flex: 1;

  margin-left: 16rpx;
}

.contact-row {
  display: flex;
  align-items: center;
}

.contact-name {
  color: #2C4A40;

  font-size: 25rpx;
  font-weight: bold;
}

.contact-phone {
  margin-left: 14rpx;

  color: #788983;

  font-size: 20rpx;
}

.address {
  display: block;

  margin-top: 6rpx;

  color: #788983;

  font-size: 20rpx;

  line-height: 1.5;
}

.pickup-title {
  display: block;

  color: #2C4A40;

  font-size: 25rpx;
  font-weight: bold;
}

.pickup-desc {
  display: block;

  margin-top: 6rpx;

  color: #788983;

  font-size: 20rpx;
}


/* 备注 */
.remark {
  margin-top: 18rpx;

  padding: 18rpx;

  border-radius: 18rpx;

  background: #F4F6F5;

  color: #52685F;

  font-size: 22rpx;

  line-height: 1.7;
}


/* 金额 */
.price-card {
  padding-bottom: 24rpx;
}

.price-row {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 17rpx;

  color: #687A74;

  font-size: 21rpx;
}

.price-line {
  height: 1rpx;

  margin: 6rpx 0 20rpx;

  background: #EDF0EE;
}

.total-row {
  margin-bottom: 0;
}

.total-row text:first-child {
  color: #304B42;

  font-size: 27rpx;
  font-weight: bold;
}

.total-price {
  color: #DF6A43;

  font-size: 37rpx;
  font-weight: bold;
}


/* 订单信息 */
.order-info-card {
  padding-bottom: 18rpx;
}

.simple-row {
  display: flex;

  justify-content: space-between;

  padding: 15rpx 0;

  color: #72817C;

  font-size: 20rpx;

  border-bottom: 1rpx solid #EDF0EE;
}

.simple-row:last-child {
  border-bottom: none;
}


/* 底部 */
.bottom-bar {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 20;

  height: 110rpx;

  display: flex;
  justify-content: flex-end;
  align-items: center;

  gap: 14rpx;

  padding: 0 24rpx;

  background: rgba(255,255,255,.97);

  box-shadow: 0 -10rpx 28rpx rgba(31,70,60,.08);
}

.bottom-btn {
  min-width: 190rpx;

  height: 70rpx;

  margin: 0;

  padding: 0 24rpx;

  line-height: 70rpx;

  border-radius: 38rpx;

  background: #EEF2F0;

  color: #50665D;

  font-size: 22rpx;
}

.bottom-btn.primary {
  background: #1F6A57;
  color: white;
}

button::after {
  border: none;
}

.cancelled-status {
  background: #7F8884;
}

.advance-btn {
  height: 88rpx;

  margin: 20rpx 28rpx;

  border-radius: 44rpx;

  background: #1F6A57;

  color: #FFFFFF;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 28rpx;
  font-weight: 600;
}
.waiting-btn {
  color: #718079;
  background: #F1F3F2;
  border: 1rpx solid #E1E6E3;
}
/* =========================
   订单费用明细
========================= */

.discount-price {
  color: #DF6A43;
}

.payment-method-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 12rpx;
  padding-top: 14rpx;

  border-top: 1rpx solid #E9ECEA;

  color: #718079;
  font-size: 22rpx;
}

.payment-method-value {
  color: #405B51;
  font-weight: 500;
}
.reviewed-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

/* =========================
   已完成订单：底部操作栏
========================= */

/* 底部操作栏改为从左到右排列 */
.bottom-bar {
  justify-content: flex-start;
  gap: 0;
  padding: 0 18rpx;
}

/* 已完成订单底部按钮 */
.completed-bottom-actions .bottom-btn {
  min-width: 0;

  width: 172rpx;
  height: 70rpx;

  margin: 0;
  padding: 0 18rpx;

  line-height: 70rpx;

  border-radius: 38rpx;

  font-size: 22rpx;

  flex-shrink: 0;
}

/* 更多：保持在最左边 */
.completed-bottom-actions .more-btn {
  width: 82rpx;

  margin-right: 18rpx;

  background: #EEF2F0;
  color: #50665D;
}

/* 申请退款 */
.completed-bottom-actions .refund-bottom-btn {
  width: 172rpx;

  margin-right: 6rpx;

  background: #EEF2F0;
  color: #50665D;
}

/* 评价商品 */
.completed-bottom-actions .review-bottom-btn {
  width: 172rpx;

  margin-right: 6rpx;

  background: #EEF2F0;
  color: #50665D;
}

/* 再来一单 */
.completed-bottom-actions .reorder-bottom-btn {
  width: 172rpx;

  background: #1F6A57;
  color: #FFFFFF;
}


/* =========================
   更多操作弹窗
========================= */

.more-menu-mask {
  position: fixed;

  left: 0;
  right: 0;
  top: 0;
  bottom: 110rpx;

  z-index: 100;

  background: rgba(0, 0, 0, .12);

  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
}

/* 更多菜单 */
.more-menu {
  width: 300rpx;

  margin-left: 18rpx;
  margin-bottom: 18rpx;

  padding: 10rpx;

  border-radius: 22rpx;

  background: #FFFFFF;

  box-shadow: 0 8rpx 35rpx rgba(0, 0, 0, .15);
}

/* 更多菜单里的按钮 */
.more-menu-item {
  width: 100%;

  height: 76rpx;

  margin: 0;

  padding: 0;

  line-height: 76rpx;

  background: #FFFFFF;

  color: #405B51;

  font-size: 24rpx;

  text-align: center;

  border-radius: 16rpx;
}

/* 删除订单：红色 */
.more-menu-item.danger {
  color: #D9534F;
}

.more-menu-item:active {
  background: #F5F7F6;
}

/* =========================
   订单详情底部操作
========================= */

.bottom-bar {
  justify-content: flex-start;
  padding: 0 18rpx;
}

/* 整个订单操作区域 */
.order-actions {
  width: 100%;

  display: flex;
  align-items: center;
}

/* 左侧“更多” */
.order-actions .more-btn {
  width: 82rpx;
  min-width: 82rpx;

  height: 70rpx;
  line-height: 70rpx;

  margin: 0;
  padding: 0;

  border-radius: 38rpx;

  background: #EEF2F0;
  color: #50665D;

  font-size: 22rpx;

  flex-shrink: 0;
}

/* 右侧三个按钮整体 */
.right-actions {
  margin-left: auto;

  display: flex;
  align-items: center;

  gap: 6rpx;
}

/* 申请退款、评价商品、再来一单统一大小 */
.right-actions .bottom-btn {
  width: 172rpx;
  min-width: 172rpx;

  height: 70rpx;

  margin: 0;
  padding: 0 12rpx;

  line-height: 70rpx;

  border-radius: 38rpx;

  font-size: 22rpx;

  flex-shrink: 0;
}

/* 申请退款 */
.right-actions .refund-bottom-btn {
  background: #EEF2F0;
  color: #50665D;
}

/* 评价商品 */
.right-actions .review-bottom-btn {
  background: #EEF2F0;
  color: #50665D;
}

/* 再来一单 */
.right-actions .reorder-bottom-btn {
  background: #1F6A57;
  color: #FFFFFF;
}

/* =========================
   退款申请状态
   ========================= */

   .refund-info-card {
    margin: 24rpx;
    padding: 26rpx;
    background: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 6rpx 24rpx rgba(31, 70, 60, 0.06);
  }
  
  .refund-info-title {
    margin-bottom: 20rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #243B33;
  }
  
  .refund-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56rpx;
    font-size: 24rpx;
  }
  
  .refund-info-label {
    color: #718078;
  }
  
  .refund-info-value {
    color: #243B33;
    font-weight: 500;
  }
  
  .refund-success-text {
    color: #1F6A57;
    font-weight: 600;
  }
  
  .refund-rejected-text {
    color: #D9534F;
    font-weight: 600;
  }
  
  .refund-info-tip {
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #EEF2F0;
    color: #87938E;
    font-size: 22rpx;
    line-height: 1.6;
  }
  
  .refund-reason-box {
    margin-top: 18rpx;
    padding: 18rpx;
    background: #F8F9F8;
    border-radius: 12rpx;
  }
  
  .refund-reason-title {
    margin-bottom: 10rpx;
    color: #50665D;
    font-size: 22rpx;
  }
  
  .refund-reason-content {
    color: #243B33;
    font-size: 24rpx;
    line-height: 1.6;
  }
  
  .refund-status-btn {
    background: #EEF2F0 !important;
    color: #718078 !important;
    text-align: center;
    pointer-events: none;
  }