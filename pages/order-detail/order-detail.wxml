<view class="page">

<!-- 顶部 -->
<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <text class="title">
    订单详情
  </text>

</view>


<!-- 订单当前状态 -->
<view
  class="status-card {{order.status === 'cancelled' ? 'cancelled-status' : ''}}"
>

  <view class="status-icon">
    {{statusIcon}}
  </view>

  <view class="status-info">

    <text class="status-title">
      {{order.statusName}}
    </text>

    <text class="status-desc">
      {{statusDescription}}
    </text>

  </view>

</view>


<!-- 订单进度 -->
<view class="card timeline-card">

  <view class="card-title">
    订单进度
  </view>

  <!-- 正常订单时间线 -->
  <view
    wx:if="{{order.status !== 'cancelled'}}"
    class="timeline"
  >

    <view
      wx:for="{{timeline}}"
      wx:key="id"
      class="timeline-item {{item.active ? 'active' : ''}} {{item.current ? 'current' : ''}}"
    >

      <view class="timeline-left">

        <view class="timeline-dot">
          {{item.active ? '✓' : ''}}
        </view>

        <view
          wx:if="{{!item.last}}"
          class="timeline-line {{item.active ? 'line-active' : ''}}"
        >
        </view>

      </view>

      <view class="timeline-content">

        <text class="timeline-name">
          {{item.name}}
        </text>

        <text
          wx:if="{{item.time}}"
          class="timeline-time"
        >
          {{item.time}}
        </text>

      </view>

    </view>

  </view>


  <!-- 已取消订单 -->
  <view
    wx:if="{{order.status === 'cancelled'}}"
    class="cancel-timeline"
  >

    <view class="cancel-step">

      <view class="timeline-left">

        <view class="timeline-dot active-dot">
          ✓
        </view>

        <view class="timeline-line line-active">
        </view>

      </view>

      <view class="timeline-content">

        <text class="timeline-name">
          已下单
        </text>

        <text class="timeline-time">
          {{order.createTime}}
        </text>

      </view>

    </view>


    <view class="cancel-step">

      <view class="timeline-left">

        <view class="timeline-dot cancel-dot">
          ×
        </view>

      </view>

      <view class="timeline-content">

        <text class="timeline-name cancel-name">
          已取消
        </text>

        <text class="timeline-time">
          {{order.cancelTime}}
        </text>

      </view>

    </view>

  </view>

</view>


<!-- 商品 -->
<view class="card">

  <view class="card-title">
    商品明细
  </view>

  <view
  wx:for="{{order.items}}"
  wx:key="id"
  class="food-row"
>

  <image
    class="food-image"
    src="{{item.image}}"
    mode="aspectFill"
  />

  <view class="food-info">

    <text class="food-name">
      {{item.name}}
    </text>

    <text class="food-desc">
      {{item.desc}}
    </text>

  </view>

  <view class="food-right">

    <text class="food-count">
      ×{{item.count}}
    </text>

    <text class="food-price">
      ¥{{item.price * item.count}}
    </text>


  </view>

</view>

</view>


<!-- 配送信息 -->
<view class="card">

  <view class="card-title">
    配送信息
  </view>


  <!-- 配送 -->
  <view
    wx:if="{{order.deliveryType === 'delivery'}}"
    class="info-row"
  >

    <view class="info-icon">
      📍
    </view>

    <view class="info-content">

      <view class="contact-row">

        <text class="contact-name">
          {{order.address.name}}
        </text>

        <text class="contact-phone">
          {{order.address.phone}}
        </text>

      </view>

      <text class="address">
        {{order.address.detail}}
      </text>

    </view>

  </view>


  <!-- 自取 -->
  <view
    wx:if="{{order.deliveryType === 'pickup'}}"
    class="info-row"
  >

    <view class="info-icon">
      🏪
    </view>

    <view class="info-content">

      <text class="pickup-title">
        到店自取
      </text>

      <text class="pickup-desc">
        请到餐厅前台报订单号取餐
      </text>

    </view>

  </view>

</view>


<!-- 备注 -->
<view
  wx:if="{{order.remark}}"
  class="card"
>

  <view class="card-title">
    订单备注
  </view>

  <view class="remark">
    {{order.remark}}
  </view>

</view>


<!-- 金额 -->
<view class="card price-card">

<!-- 商品小计 -->
<view class="price-row">

  <text>
    商品小计
  </text>

  <text>
    ¥{{order.cartTotal}}
  </text>

</view>


<!-- 商品优惠 -->
<view
  wx:if="{{order.productDiscount > 0}}"
  class="price-row"
>

  <text>
    商品优惠
  </text>

  <text class="discount-price">
    -¥{{order.productDiscount}}
  </text>

</view>


<!-- 优惠券 -->
<view
  wx:if="{{order.couponDiscount > 0}}"
  class="price-row"
>

  <text>
    优惠券
  </text>

  <text class="discount-price">
    -¥{{order.couponDiscount}}
  </text>

</view>


<!-- 打包费 -->
<view class="price-row">

  <text>
    打包费
  </text>

  <text>
    ¥{{order.packingFee}}
  </text>

</view>


<!-- 配送费 -->
<view class="price-row">

  <text>
    配送费
  </text>

  <text wx:if="{{order.deliveryFee === 0}}">
    免配送费
  </text>

  <text wx:if="{{order.deliveryFee > 0}}">
    ¥{{order.deliveryFee}}
  </text>

</view>


<view class="price-line">
</view>


<!-- 实付金额 -->
<view class="price-row total-row">

  <text>
    {{order.status === 'cancelled' ? '订单金额' : '实付金额'}}
  </text>

  <text class="total-price">
    ¥{{order.finalTotal}}
  </text>

</view>


<!-- 支付方式 -->
<view class="payment-method-row">

  <text>
    支付方式
  </text>

  <text class="payment-method-value">
    {{order.paymentMethod || '微信支付'}}
  </text>

</view>

</view>


<!-- 订单信息 -->
<view class="card order-info-card">

  <view class="card-title">
    订单信息
  </view>

  <view class="simple-row">

    <text>
      订单编号
    </text>

    <text>
      {{order.id}}
    </text>

  </view>

  <view class="simple-row">

    <text>
      下单时间
    </text>

    <text>
      {{order.createTime}}
    </text>

  </view>

  <view class="simple-row">

    <text>
      配送方式
    </text>

    <text>
      {{order.deliveryType === 'delivery' ? '配送到家' : '到店自取'}}
    </text>

  </view>

  <!-- 取消时间 -->
  <view
    wx:if="{{order.status === 'cancelled'}}"
    class="simple-row"
  >

    <text>
      取消时间
    </text>

    <text>
      {{order.cancelTime}}
    </text>

  </view>

</view>

<!-- =========================
     退款申请状态
     ========================= -->
     <view
  wx:if="{{refund}}"
  class="refund-info-card"
>

  <view class="refund-info-title">
    退款申请
  </view>

  <!-- 审核中 -->
  <view wx:if="{{refundStatus === 'pending_review'}}">
    <view class="refund-info-row">
      <text class="refund-info-label">申请状态</text>
      <text class="refund-info-value">已申请退款</text>
    </view>

    <view class="refund-info-row">
      <text class="refund-info-label">退款金额</text>
      <text class="refund-info-value">
        ¥{{refundAmountText}}
      </text>
    </view>

    <view class="refund-info-tip">
      退款申请已经提交，请等待餐厅审核。
    </view>
  </view>

  <!-- 审核通过 -->
  <view wx:if="{{refundStatus === 'completed'}}">
    <view class="refund-info-row">
      <text class="refund-info-label">申请状态</text>
      <text class="refund-success-text">退款成功</text>
    </view>

    <view class="refund-info-row">
      <text class="refund-info-label">退款金额</text>
      <text class="refund-info-value">
        ¥{{refundAmountText}}
      </text>
    </view>

    <view class="refund-info-tip">
      退款已经审核通过，款项已退回您的账户余额。
    </view>
  </view>

  <!-- 审核不通过 -->
  <view wx:if="{{refundStatus === 'rejected'}}">
    <view class="refund-info-row">
      <text class="refund-info-label">申请状态</text>
      <text class="refund-rejected-text">审核未通过</text>
    </view>

    <view class="refund-info-row">
      <text class="refund-info-label">退款金额</text>
      <text class="refund-info-value">
        ¥{{refundAmountText}}
      </text>
    </view>

    <view class="refund-reason-box">
      <view class="refund-reason-title">
        未通过原因
      </view>

      <view class="refund-reason-content">
        {{refundReviewRemark || '餐厅未填写具体原因'}}
      </view>
    </view>

    <view class="refund-info-tip">
      该订单已经提交过退款申请，不能再次申请。
    </view>
  </view>

</view>

<!-- 底部操作 -->
<view class="bottom-bar">

<!-- =========================
     已完成订单
========================== -->
<view
  wx:if="{{order.status === 'completed'}}"
  class="order-actions"
>

  <!-- 左侧：更多 -->
  <button
    class="bottom-btn more-btn"
    bindtap="showMoreActions"
  >
    更多
  </button>

  <!-- 右侧操作组 -->
  <view class="right-actions">

    <!-- 申请退款 -->
    <!-- =========================
     没有退款记录
     ========================= -->
<button
  wx:if="{{!refund}}"
  class="bottom-btn refund-bottom-btn"
  bindtap="applyRefund"
>
  申请退款
</button>


<!-- =========================
     退款审核中
     ========================= -->
<view
  wx:if="{{refundStatus === 'pending_review'}}"
  class="bottom-btn refund-status-btn"
>
  已申请退款
</view>


<!-- =========================
     退款成功
     ========================= -->
<view
  wx:if="{{refundStatus === 'completed'}}"
  class="bottom-btn refund-status-btn"
>
  退款成功
</view>


<!-- =========================
     退款被拒绝
     ========================= -->
<view
  wx:if="{{refundStatus === 'rejected'}}"
  class="bottom-btn refund-status-btn"
>
  已拒绝
</view>

    <!-- 评价商品 -->
    <button
      class="bottom-btn review-bottom-btn"
      bindtap="openOrderReview"
    >
      评价商品
    </button>

    <!-- 再来一单 -->
    <button
      class="bottom-btn primary reorder-bottom-btn"
      bindtap="reorder"
    >
      再来一单
    </button>

  </view>

</view>


<!-- =========================
     非完成状态
========================== -->
<view
  wx:if="{{order.status !== 'completed' && order.status !== 'cancelled'}}"
  class="order-actions"
>

  <!-- 左侧：更多 -->
  <button
    class="bottom-btn more-btn"
    bindtap="showMoreActions"
  >
    更多
  </button>

  <!-- 右侧：申请退款 -->
  <view class="right-actions">

<!-- =========================
     退款状态
     ========================= -->

<!-- 还没有申请退款 -->
<button
  wx:if="{{!refund}}"
  class="bottom-btn refund-bottom-btn"
  bindtap="applyRefund"
>
  申请退款
</button>

<!-- 退款审核中 -->
<view
  wx:if="{{refundStatus === 'pending_review'}}"
  class="bottom-btn refund-status-btn"
>
  已申请退款
</view>

<!-- 退款已经通过 -->
<view
  wx:if="{{refundStatus === 'completed'}}"
  class="bottom-btn refund-status-btn"
>
  退款成功
</view>

<!-- 退款申请被拒绝 -->
<view
  wx:if="{{refundStatus === 'rejected'}}"
  class="bottom-btn refund-status-btn"
>
  已拒绝
</view>

    <!-- 待付款 -->
    <button
      wx:if="{{order.status === 'pending' && order.paymentStatus !== 'paid'}}"
      class="bottom-btn primary"
      bindtap="payOrder"
    >
      去付款
    </button>

    <!-- 已付款，等待商家接单 -->
    <view
      wx:if="{{order.status === 'pending' && order.paymentStatus === 'paid'}}"
      class="bottom-btn waiting-btn"
    >
      待商家接单
    </view>

  </view>

</view>


<!-- =========================
     已取消订单
========================== -->
<button
  wx:if="{{order.status === 'cancelled'}}"
  class="bottom-btn more-btn"
  bindtap="showMoreActions"
>
  更多
</button>

</view>

<!-- 更多操作弹窗 -->
<view
  wx:if="{{showMoreMenu}}"
  class="more-menu-mask"
  bindtap="hideMoreActions"
>

  <view
    class="more-menu"
    catchtap="stopMoreMenuTap"
  >

    <!-- 联系餐厅 -->
    <button
      class="more-menu-item"
      bindtap="contactRestaurant"
    >
      联系餐厅
    </button>

    <!-- 投诉 -->
    <button
      class="more-menu-item"
      bindtap="submitComplaint"
    >
      投诉
    </button>

    <!-- 删除订单 -->
    <button
      class="more-menu-item danger"
      bindtap="deleteOrder"
    >
      删除订单
    </button>

  </view>

</view>

</view>