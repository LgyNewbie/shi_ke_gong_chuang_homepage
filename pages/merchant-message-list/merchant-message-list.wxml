<view class="page">

<!-- 顶部 -->
<view class="header">

  <view>
    <view class="title">
      留言管理
    </view>

    <view class="subtitle">
      食客共创 · 建议与反馈
    </view>
  </view>

</view>


<!-- 数据统计 -->
<view class="stats">

  <view class="stat-card">
    <view class="stat-number">
      {{allCount}}
    </view>
    <view class="stat-label">
      全部
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{pendingCount}}
    </view>
    <view class="stat-label">
      待处理
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{reviewCount}}
    </view>
    <view class="stat-label">
      评估中
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{acceptedCount}}
    </view>
    <view class="stat-label">
      已采纳
    </view>
  </view>

</view>


<!-- 分类 -->
<scroll-view
  class="tabs-scroll"
  scroll-x
>

  <view class="tabs">

    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{currentTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </view>

  </view>

</scroll-view>


<!-- 留言列表 -->
<view class="message-list">

  <view
    wx:for="{{filteredMessages}}"
    wx:key="id"
    class="message-card"
    data-id="{{item.id}}"
    bindtap="openMessage"
  >

    <!-- 用户 -->
    <view class="user-row">

      <view class="avatar">
        {{item.name ? item.name.substring(0, 1) : '食'}}
      </view>

      <view class="user-info">

        <view class="user-name">
          {{item.name || item.userName || '食客'}}

          <text class="level">
            Lv.{{item.level || 1}}
          </text>
        </view>

        <view class="time">
          {{item.time || item.createTime || '刚刚'}}
        </view>

      </view>

    </view>


    <!-- 分类 -->
    <view class="message-tag">
      {{item.tag || item.category || '其他'}}
    </view>


    <!-- 内容 -->
    <view class="message-text">
      {{item.text || item.content}}
    </view>


    <!-- 图片 -->
    <image
      wx:if="{{item.image}}"
      class="message-image"
      src="{{item.image}}"
      mode="aspectFill"
    ></image>


    <!-- 状态 -->
    <view class="message-bottom">

      <view class="message-bottom">

<view
  class="status status-{{item.status}}"
>
  {{item.statusName || '待处理'}}
</view>

<view class="bottom-actions">

  <view
    class="detail-arrow"
    data-id="{{item.id}}"
    catchtap="openMessage"
  >
    去处理 ›
  </view>

  <view
    wx:if="{{item.status !== 'poll' && item.status !== 'rejected'}}"
    class="poll-action"
    data-id="{{item.id}}"
    catchtap="createPoll"
  >
    转为投票
  </view>

</view>

</view>

    </view>

  </view>

</view>


<!-- 空状态 -->
<view
  wx:if="{{filteredMessages.length === 0}}"
  class="empty"
>

  <view class="empty-icon">
    💬
  </view>

  <view class="empty-title">
    暂无留言
  </view>

  <view class="empty-text">
    当前分类下还没有食客留言
  </view>

</view>

</view>