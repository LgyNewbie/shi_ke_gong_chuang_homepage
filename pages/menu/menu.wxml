<view class="page">

<!-- 顶部 -->
<view class="header">

  <view class="header-title">
    <text class="title">点餐</text>
    <text class="subtitle">今天想吃点什么？</text>
  </view>

  <view
  class="order-history"
  bindtap="openOrders"
  >
  📋
  </view>

</view>


<!-- 搜索 -->
<view class="search-box">

  <text class="search-icon">⌕</text>

  <input
    class="search-input"
    placeholder="搜索菜品、套餐..."
    value="{{searchText}}"
    bindinput="onSearchInput"
    confirm-type="search"
  />

  <text
    wx:if="{{searchText}}"
    class="clear"
    bindtap="clearSearch"
  >
    ×
  </text>

</view>


<!-- 分类 -->
<scroll-view
  class="category-scroll"
  scroll-x="true"
  show-scrollbar="false"
>

  <view class="category-list">

    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{currentCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >

      <text>{{item.name}}</text>

    </view>

  </view>

</scroll-view>


<!-- 今日推荐 -->
<view
  wx:if="{{!searchText && currentCategory === 'all'}}"
  class="recommend"
>

  <view class="recommend-left">

    <text class="recommend-label">
      今日推荐
    </text>

    <text class="recommend-title">
      大家最爱吃的招牌菜
    </text>

    <text class="recommend-subtitle">
      新鲜制作 · 当日供应
    </text>

  </view>

  <text class="recommend-icon">
    🍱
  </text>

</view>


<!-- 商品列表 -->
<view class="food-list">

  <view
    wx:for="{{filteredFoods}}"
    wx:key="id"
    class="food-card"
  >

    <!-- 商品图片 -->
    <image
      class="food-image"
      src="{{item.image}}"
      mode="aspectFill"
    />


    <!-- 商品信息 -->
    <view class="food-info">

      <view class="food-title-row">

        <view class="food-title-box">

          <view class="food-name-row">

<view class="food-name">
  {{item.name}}
</view>

<view
  class="favorite-icon {{item.isFavorite ? 'favorite-active' : ''}}"
  data-id="{{item.id}}"
  catchtap="toggleFavorite"
>
  {{item.isFavorite ? '♥' : '♡'}}
</view>

</view>

          <!-- 展开 / 收起 -->
          <text
            class="expand-icon {{expandedId === item.id ? 'rotate' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleDetail"
          >
            ⌄
          </text>

        </view>

        <text class="hot-tag" wx:if="{{item.hot}}">
          热销
        </text>

      </view>


      <!-- 商品简短介绍 -->
      <text class="food-desc">
        {{item.desc}}
      </text>


      <!-- 展开的详细信息 -->
      <view
        wx:if="{{expandedId === item.id}}"
        class="food-detail"
      >

        <view class="detail-row">

          <text class="detail-label">食材</text>
          <text class="detail-value">
            {{item.ingredients}}
          </text>

        </view>

        <view class="detail-row">

          <text class="detail-label">口味</text>
          <text class="detail-value">
            {{item.taste}}
          </text>

        </view>

        <view class="detail-row">

          <text class="detail-label">分量</text>
          <text class="detail-value">
            {{item.weight}}
          </text>

        </view>

        <view
          wx:if="{{item.allergen}}"
          class="detail-row"
        >

          <text class="detail-label">提示</text>
          <text class="detail-value warning">
            {{item.allergen}}
          </text>

        </view>

      </view>


      <!-- 底部价格和按钮 -->
      <view class="food-bottom">

        <view class="price-box">

          <text class="price-symbol">
            ¥
          </text>

          <text class="price">
            {{item.price}}
          </text>

          <text class="sales">
            已售 {{item.sales}}
          </text>

        </view>


        <view class="add-btn-box">

          <view
            wx:if="{{item.count > 0}}"
            class="minus-btn"
            data-id="{{item.id}}"
            bindtap="decreaseFood"
          >
            −
          </view>

          <text
            wx:if="{{item.count > 0}}"
            class="food-count"
          >
            {{item.count}}
          </text>

          <view
            class="plus-btn"
            data-id="{{item.id}}"
            bindtap="increaseFood"
          >
            +
          </view>

        </view>

      </view>

    </view>

  </view>


  <!-- 没有商品 -->
  <view
    wx:if="{{filteredFoods.length === 0}}"
    class="empty"
  >

    <text class="empty-icon">
      🍽️
    </text>

    <text class="empty-title">
      没找到相关菜品
    </text>

    <text class="empty-text">
      换个关键词试试吧
    </text>

  </view>

</view>


<!-- 右下角购物车 -->
<view
  wx:if="{{cartCount > 0}}"
  class="cart-float"
  bindtap="openCart"
>

  <view class="cart-icon">
    🛒
  </view>

  <view class="cart-badge">
    {{cartCount}}
  </view>

  <view class="cart-info">

    <text class="cart-total">
      ¥{{cartTotal}}
    </text>

    <text class="cart-tip">
      已选{{cartCount}}件
    </text>

  </view>

  <text class="cart-arrow">
    ›
  </text>

</view>


<!-- 没有购物车时的提示 -->
<view
  wx:if="{{cartCount === 0}}"
  class="cart-empty-float"
>

  <text>🛒</text>
  <text>购物车</text>

</view>

</view>