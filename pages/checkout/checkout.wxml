<view class="page">

<!-- 顶部 -->
<view class="header">

  <view class="back" bindtap="goBack">
    ‹
  </view>

  <text class="title">
    提交订单
  </text>

</view>


<!-- 配送方式 -->
<view class="card">

  <view class="card-title">
    配送方式
  </view>

  <view class="delivery-tabs">

    <view
      class="delivery-tab {{deliveryType === 'delivery' ? 'active' : ''}}"
      data-type="delivery"
      bindtap="selectDeliveryType"
    >
      <text class="delivery-icon">🚚</text>
      <text>配送到家</text>
    </view>

    <view
      class="delivery-tab {{deliveryType === 'pickup' ? 'active' : ''}}"
      data-type="pickup"
      bindtap="selectDeliveryType"
    >
      <text class="delivery-icon">🏪</text>
      <text>到店自取</text>
    </view>

  </view>

</view>


<!-- 地址 -->
<view
  wx:if="{{deliveryType === 'delivery'}}"
  class="card address-card"
  bindtap="chooseAddress"
>

  <view class="address-icon">
    📍
  </view>

  <view class="address-info">

    <view class="address-top">

      <text class="contact-name">
        {{address.name}}
      </text>

      <text class="contact-phone">
        {{address.phone}}
      </text>

    </view>

    <text class="address-text">
      {{address.detail}}
    </text>

  </view>

  <text class="address-arrow">
    ›
  </text>

</view>


<!-- 自取信息 -->
<view
  wx:if="{{deliveryType === 'pickup'}}"
  class="card pickup-card"
>

  <view class="pickup-icon">
    🏪
  </view>

  <view class="pickup-info">

    <text class="pickup-title">
      到店自取
    </text>

    <text class="pickup-text">
      下单成功后请到餐厅前台取餐
    </text>

    <text class="pickup-time">
      建议取餐时间：约 20 分钟后
    </text>

  </view>

</view>


<!-- 商品 -->
<view class="card">

  <view class="card-title">
    商品明细
  </view>

  <view
    wx:for="{{cartItems}}"
    wx:key="id"
    class="food-item"
  >

    <image
      class="food-image"
      src="{{item.image}}"
      mode="aspectFill"
    />

    <view class="food-info">

      <text class="food-name">
        {{item.name}}
      </text>

      <text class="food-desc">
        {{item.desc}}
      </text>

    </view>

    <view class="food-right">

      <text class="food-count">
        ×{{item.count}}
      </text>

      <text class="food-price">
        ¥{{item.price * item.count}}
      </text>

    </view>

  </view>

</view>


<!-- 订单备注 -->
<view class="card">

  <view class="card-title">
    订单备注
  </view>

  <textarea
    class="remark"
    placeholder="有什么需要告诉餐厅的吗？例如：少辣、不要香菜..."
    maxlength="200"
    value="{{remark}}"
    bindinput="onRemarkInput"
  ></textarea>

  <text class="remark-count">
    {{remark.length}} / 200
  </text>

</view>


<!-- 价格 -->
<!-- 价格 -->
<view class="card price-card">

<view class="price-row">

  <text>
    商品小计
  </text>

  <text>
    ¥{{cartTotal}}
  </text>

</view>


<!-- 商品优惠 -->
<view
  class="price-row"
  wx:if="{{productDiscount > 0}}"
>

  <text>
    商品优惠
  </text>

  <text class="discount-price">
    -¥{{productDiscount}}
  </text>

</view>


<!-- 优惠券 -->
<view class="price-row">

  <text>
    优惠券
  </text>

  <text
    wx:if="{{couponDiscount > 0}}"
    class="discount-price"
  >
    -¥{{couponDiscount}}
  </text>

  <text
    wx:if="{{couponDiscount === 0}}"
    class="no-coupon"
  >
    暂无优惠
  </text>

</view>


<!-- 打包费 -->
<view class="price-row">

  <text>
    打包费
  </text>

  <text>
    ¥{{packingFee}}
  </text>

</view>


<!-- 配送费 -->
<view class="price-row">

  <text>
    配送费
  </text>

  <text wx:if="{{deliveryFee === 0}}">
    免配送费
  </text>

  <text
    wx:if="{{deliveryFee > 0}}"
  >
    ¥{{deliveryFee}}
  </text>

</view>


<view class="price-line"></view>


<!-- 实付金额 -->
<view class="price-row final-row">

  <text>
    实付金额
  </text>

  <text class="final-price">
    ¥{{finalTotal}}
  </text>

</view>

</view>


<!-- 支付方式 -->
<view class="card payment-card">

<view class="card-title">
  支付方式
</view>

<view class="payment-options">

  <view
    class="payment-option {{paymentMethod === '微信支付' ? 'active' : ''}}"
    data-method="微信支付"
    bindtap="selectPaymentMethod"
  >

    <view class="payment-icon">
      💳
    </view>

    <view class="payment-info">

      <view class="payment-name">
        微信支付
      </view>

      <view class="payment-desc">
        模拟支付
      </view>

    </view>

    <view
      class="payment-check"
      wx:if="{{paymentMethod === '微信支付'}}"
    >
      ✓
    </view>

  </view>


  <view
    class="payment-option {{paymentMethod === '到店付款' ? 'active' : ''}}"
    data-method="到店付款"
    bindtap="selectPaymentMethod"
  >

    <view class="payment-icon">
      🏪
    </view>

    <view class="payment-info">

      <view class="payment-name">
        到店付款
      </view>

      <view class="payment-desc">
        到店后支付
      </view>

    </view>

    <view
      class="payment-check"
      wx:if="{{paymentMethod === '到店付款'}}"
    >
      ✓
    </view>

  </view>

</view>

</view>


<!-- 底部 -->
<view class="bottom-bar">

  <view class="bottom-total">

    <text>
      合计
    </text>

    <text class="bottom-price">
      ¥{{finalTotal}}
    </text>

  </view>

  <button
    class="submit-btn"
    bindtap="submitOrder"
  >
    提交订单 · ¥{{finalTotal}}
  </button>

</view>

</view>