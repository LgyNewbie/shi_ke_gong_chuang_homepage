<view class="page">

<!-- 顶部 -->

<view class="header">

  <view class="title">
    投票管理
  </view>

  <view class="subtitle">
    查看投票结果并处理食客共创建议
  </view>

</view>


<!-- =========================
     多张投票
========================== -->

<view
  wx:for="{{polls}}"
  wx:key="id"
  class="poll-card"
>

  <!-- 投票头部 -->

  <view class="poll-head">

    <view class="active-badge">

      {{
        item.statusName ||
        (
          item.status === 'active'
            ? '进行中'
            : '已结束'
        )
      }}

    </view>

    <view class="poll-time">
      {{item.createTime}}
    </view>

  </view>


  <!-- 标题 -->

  <view class="poll-title">
    {{item.title}}
  </view>

  <view class="decision-buttons">

<view
  class="accept-btn"
  catchtap="openDetail"
  data-poll-id="{{item.id}}"
>
  查看详情
</view>

</view>


  <!-- 投票说明 -->

  <view
    wx:if="{{item.description}}"
    class="poll-description"
  >
    {{item.description}}
  </view>


  <!-- 来源留言 -->

  <view
    wx:if="{{item.sourceMessage}}"
    class="source-box"
  >

    <view class="source-label">
      来源建议
    </view>

    <view class="source-text">
      {{
        item.sourceMessage.text ||
        item.sourceMessage.content
      }}
    </view>

    <view class="source-user">
      {{
        item.sourceMessage.name ||
        item.sourceMessage.userName ||
        '食客'
      }}
    </view>

  </view>


  <!-- 截止时间 -->

  <view
    wx:if="{{item.endDate}}"
    class="poll-deadline"
  >
    截止：{{item.endDate}}
  </view>


  <!-- =========================
       投票结果
  ========================== -->

  <view class="result-title">

    {{
      item.status === 'active'
        ? '当前投票结果'
        : '最终投票结果'
    }}

  </view>


  <view
    wx:for="{{item.options}}"
    wx:for-item="option"
    wx:key="id"
    class="result-row"
  >

    <view class="result-top">

      <view class="option-name-box">

<text class="option-name">
  {{option.name}}
</text>

<text
  wx:if="{{option.isWinner}}"
  class="winner-tag"
>
  🏆最高票
</text>

</view>

      <text class="option-count">
        {{option.votes || 0}} 票 · {{option.percent || 0}}%
      </text>

    </view>


    <view class="progress-bg">

<view
  class="progress-fill"
  style="{{option.percentStyle}}"
></view>

</view>

  </view>


  <!-- 总票数 -->

  <view class="total-votes">

    共 {{item.totalVotes || 0}} 人参与投票

  </view>


  <!-- =========================
       进行中：结束投票
  ========================== -->

  <view
    wx:if="{{item.status === 'active'}}"
    class="decision-area"
  >

    <view class="decision-title">
      当前投票正在进行
    </view>


    <view class="decision-buttons">

      <view
        class="accept-btn"
        catchtap="endPoll"
        data-poll-id="{{item.id}}"
      >
        结束投票
      </view>

    </view>

  </view>


  <!-- =========================
       已结束：商家处理
  ========================== -->

  <view
    wx:if="{{item.status === 'ended'}}"
    class="decision-area"
  >

    <view class="decision-title">
      投票已经结束，请根据最终结果处理这条食客建议
    </view>


    <view class="decision-buttons">

      <view
        class="accept-btn"
        catchtap="makeDecision"
        data-poll-id="{{item.id}}"
        data-result="accepted"
      >
        采纳建议
      </view>


      <view
        class="reject-btn"
        catchtap="makeDecision"
        data-poll-id="{{item.id}}"
        data-result="rejected"
      >
        暂不采纳
      </view>

    </view>

  </view>


  <!-- =========================
       已采纳
  ========================== -->

  <view
    wx:if="{{item.status === 'accepted'}}"
    class="decision-result accepted-result"
  >
    ✓ 这条建议已采纳
  </view>


  <!-- =========================
       暂不采纳
  ========================== -->

  <view
    wx:if="{{item.status === 'rejected'}}"
    class="decision-result rejected-result"
  >
    已结束：这条建议暂不采纳
  </view>


  <!-- 结束时间 -->

  <view
    wx:if="{{item.endTime}}"
    class="poll-end-time"
  >
    投票结束：{{item.endTime}}
  </view>

</view>


<!-- =========================
     没有投票
========================== -->

<view
  wx:if="{{polls.length === 0}}"
  class="empty"
>

  <view class="empty-icon">
    🗳️
  </view>

  <view class="empty-title">
    当前没有投票
  </view>

  <view class="empty-text">
    将食客建议转为投票后，会显示在这里
  </view>

</view>

</view>