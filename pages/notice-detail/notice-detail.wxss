page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 50rpx;
}

/* 顶部 */

.detail-header {
  padding: 44rpx 32rpx 34rpx;
}

.notice-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.type-business {
  background: #EEF5F2;
  color: #1F6A57;
}

.type-event {
  background: #FFF2E9;
  color: #D46B3D;
}

.type-new {
  background: #F3EDFF;
  color: #7656B7;
}

.notice-date {
  font-size: 23rpx;
  color: #9AA39F;
}

.title {
  margin-top: 24rpx;
  font-size: 42rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #173C34;
}

/* 正文 */

.content-card {
  margin: 0 28rpx;
  padding: 34rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.content-paragraph {
  font-size: 29rpx;
  line-height: 1.9;
  color: #4F6059;
  margin-bottom: 24rpx;
}

.content-paragraph:last-child {
  margin-bottom: 0;
}

/* 底部 */

.bottom-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  background: #EEF7F3;
  border-radius: 24rpx;
}

.bottom-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: #667C73;
  margin-bottom: 22rpx;
}

button {
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.community-btn {
  background: #FFFFFF;
  color: #1F6A57;
  border: 2rpx solid #B8D6CA;
  margin-bottom: 18rpx;
}

.menu-btn {
  background: #1F6A57;
  color: #FFFFFF;
}