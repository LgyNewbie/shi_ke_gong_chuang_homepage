.page {
  min-height: 100vh;
  background: #F7F5EF;
}

.page-header {
  height: 96rpx;
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 32rpx;
  background: #F7F5EF;
}

.back-btn {
  width: 64rpx;
  font-size: 56rpx;
  line-height: 1;
  color: #173C34;
}

.page-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #173C34;
}

.detail-card {
  margin: 24rpx 28rpx;
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  box-sizing: border-box;
}

.detail-type {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #E7F2ED;
  color: #1F6A57;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #173C34;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #EEEEEA;
  color: #999;
  font-size: 23rpx;
}

.detail-content {
  padding-top: 30rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #46534E;
  white-space: pre-wrap;
}

.empty {
  text-align: center;
  padding-top: 180rpx;
  color: #999;
  font-size: 28rpx;
}