<view class="page">

<view class="page-header">
  <view class="back-btn" bindtap="goBack">‹</view>
  <view class="page-title">公告详情</view>
</view>

<view wx:if="{{notice}}" class="detail-card">

  <view class="detail-type">
    {{notice.type}}
  </view>

  <view class="detail-title">
    {{notice.title}}
  </view>

  <view class="detail-meta">
    <text>{{notice.author}}</text>
    <text>{{notice.time}}</text>
  </view>

  <view class="detail-content">
    {{notice.content}}
  </view>

</view>

<view
  wx:if="{{!notice}}"
  class="empty"
>
  暂无公告内容
</view>

</view>