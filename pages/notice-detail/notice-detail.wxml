<view class="page">

<!-- 顶部信息 -->
<view class="detail-header">

  <view class="notice-top">
    <view class="notice-tag {{notice.typeClass}}">
      {{notice.type}}
    </view>

    <view class="notice-date">
      {{notice.date}}
    </view>
  </view>

  <view class="title">
    {{notice.title}}
  </view>

</view>

<!-- 正文 -->
<view class="content-card">

  <view
    wx:for="{{notice.content}}"
    wx:key="index"
    class="content-paragraph"
  >
    {{item}}
  </view>

</view>

<!-- 底部操作 -->
<view class="bottom-card">

  <view class="bottom-tip">
    想了解更多餐厅动态，可以去看看食客留言和本周投票。
  </view>

  <button class="community-btn" bindtap="goCommunity">
    看食客留言
  </button>

  <button class="menu-btn" bindtap="goMenu">
    去点餐
  </button>

</view>

</view>