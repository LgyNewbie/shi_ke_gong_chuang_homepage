page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.hero {
  position: relative;
  min-height: 330rpx;
  padding: 34rpx 34rpx 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #F6F3E8 0%, #EEF3EA 100%);
}

.brand-row {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 3;
}

.logo {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: #1F6A57;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(31,106,87,.16);
}

.logo-emoji {
  font-size: 52rpx;
}

.brand-text {
  margin-left: 22rpx;
}

.brand-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #173C34;
}

.brand-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5D7770;
}

.bell {
  margin-left: auto;
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: rgba(255,255,255,.78);
  position: relative;
}

.dot {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #F07A43;
  border: 3rpx solid #fff;
}

.hero-slogan {
  position: absolute;
  right: 215rpx;
  top: 112rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  color: #1F6A57;
  font-size: 26rpx;
  line-height: 1.7;
  transform: rotate(-3deg);
}

.hero-food {
  position: absolute;
  right: -70rpx;
  bottom: -65rpx;
  width: 430rpx;
  height: 250rpx;
  border-radius: 180rpx 80rpx 40rpx 80rpx;
  opacity: .95;
}

.section {
  margin: 24rpx 26rpx 0;
}

.card {
  background: rgba(255,255,255,.94);
  border-radius: 34rpx;
  box-shadow: 0 10rpx 36rpx rgba(31,60,52,.05);
  padding: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #173C34;
}

.section-subtitle {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7A8B86;
}

.more {
  font-size: 23rpx;
  color: #5C7C73;
  padding-top: 8rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 18rpx;
}

.tab {
  padding: 13rpx 30rpx;
  border-radius: 30rpx;
  background: #F1F5F2;
  color: #60766F;
  font-size: 24rpx;
}

.tab.active {
  background: #1F6A57;
  color: #fff;
}

.message-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EDF1EF;
}

.message-item:last-child {
  border-bottom: none;
}

.avatar {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 18rpx;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-top {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 26rpx;
  color: #24483F;
  font-weight: 700;
}

.level {
  font-size: 18rpx;
  color: #E0A545;
  background: #FFF7E3;
  padding: 2rpx 8rpx;
  border-radius: 14rpx;
  margin-left: 6rpx;
}

.time {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #A0ACA8;
}

.tag {
  margin-left: auto;
  font-size: 18rpx;
  color: #1F6A57;
  padding: 5rpx 12rpx;
  background: #EFF7F3;
  border-radius: 16rpx;
}

.message-text {
  margin-top: 9rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #2C443D;
}

.message-image {
  width: 150rpx;
  height: 104rpx;
  border-radius: 18rpx;
  margin-top: 12rpx;
}

.message-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 12rpx;
  color: #6D7F79;
  font-size: 22rpx;
}

.message-actions text {
  margin-left: 6rpx;
}

.ellipsis {
  margin-left: auto;
  letter-spacing: 4rpx;
}

.poll-box {
  display: flex;
  margin-top: 22rpx;
  gap: 22rpx;
  align-items: stretch;
}

.poll-image {
  width: 210rpx;
  height: 250rpx;
  border-radius: 24rpx;
  flex: 0 0 auto;
}

.poll-content {
  flex: 1;
}

.poll-status {
  display: inline-block;
  background: #1F6A57;
  color: #fff;
  font-size: 20rpx;
  padding: 7rpx 15rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.poll-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 58rpx;
  grid-template-rows: 32rpx 16rpx;
  column-gap: 12rpx;
  margin-bottom: 18rpx;
  align-items: center;
}

.poll-name {
  grid-row: 1 / span 2;
  font-size: 23rpx;
  color: #35544B;
}

.poll-track {
  height: 14rpx;
  background: #E6ECE9;
  border-radius: 20rpx;
  overflow: hidden;
}

.poll-fill {
  height: 100%;
  background: #2E8A6F;
  border-radius: 20rpx;
}

.poll-percent {
  font-size: 20rpx;
  color: #41665B;
  text-align: right;
}

.poll-count {
  grid-column: 2 / span 2;
  font-size: 18rpx;
  color: #A5B1AD;
}

.poll-btn {
  margin: 5rpx 0 0;
  background: #1F6A57;
  color: #fff;
  border-radius: 28rpx;
  font-size: 23rpx;
  line-height: 74rpx;
  height: 74rpx;
  padding: 0 28rpx;
}

.notice-list {
  margin-top: 15rpx;
}

.notice-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDF1EF;
  gap: 12rpx;
}

.notice-row:last-child {
  border-bottom: none;
}

.notice-badge {
  width: 70rpx;
  text-align: center;
  font-size: 19rpx;
  color: #fff;
  border-radius: 10rpx;
  padding: 7rpx 0;
}

.notice-badge.business { background: #F58A45; }
.notice-badge.activity { background: #3E9B77; }
.notice-badge.new { background: #4D8FBC; }

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: #415B53;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-date {
  font-size: 19rpx;
  color: #9AA6A2;
}

.order-banner {
  margin: 24rpx 26rpx 0;
  height: 150rpx;
  border-radius: 34rpx;
  background: #1D654F;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  box-shadow: 0 10rpx 30rpx rgba(31,106,87,.16);
}

.order-banner-left {
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  position: relative;
  z-index: 2;
}

.order-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F7F5EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 18rpx;
}

.order-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.order-subtitle {
  color: rgba(255,255,255,.76);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.order-banner image {
  width: 330rpx;
  height: 180rpx;
  opacity: .76;
  transform: rotate(-3deg) scale(1.1);
  margin-right: -40rpx;
}

.write-btn {
  position: fixed;
  right: 24rpx;
  bottom: 150rpx;
  z-index: 20;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #1F6A57;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 32rpx rgba(31,106,87,.28);
}

.write-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.write-btn text:last-child {
  font-size: 21rpx;
}

.bottom-nav {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 15;
  height: 124rpx;
  border-radius: 38rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 12rpx 40rpx rgba(31,60,52,.09);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.nav-item {
  width: 25%;
  text-align: center;
  color: #73857F;
  font-size: 20rpx;
}

.nav-icon {
  display: block;
  font-size: 38rpx;
  line-height: 1.1;
  margin-bottom: 5rpx;
}

.nav-item.active {
  color: #1F6A57;
  font-weight: 700;
}

button::after {
  border: none;
}

.message-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;

  transition: all 0.15s;
}
.message-card:active {
  transform: scale(0.99);
  opacity: 0.92;
}

/* 首页动态投票 */

.poll-progress {
  flex: 1;
  margin: 0 12rpx;
}

.poll-total {
  margin-top: 14rpx;
  text-align: right;
  font-size: 21rpx;
  color: #8A9690;
}

.poll-empty {
  padding: 34rpx 20rpx;
  text-align: center;
}

.poll-empty-icon {
  font-size: 60rpx;
}

.poll-empty-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #89958F;
}

.notice-list {
  margin-top: 20rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.notice-info {
  flex: 1;
  min-width: 0;
}

.notice-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #173C34;
}

.notice-content {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #76807C;
  line-height: 1.5;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.notice-time {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #AAAAA3;
}

.notice-arrow {
  margin-left: 20rpx;
  font-size: 40rpx;
  color: #A2AAA6;
}

.empty-notice {
  padding: 50rpx 0;
  text-align: center;
  color: #999;
  font-size: 25rpx;
}