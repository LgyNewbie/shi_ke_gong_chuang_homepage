page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 50rpx;
}


/* 顶部 */
.header {
  height: 115rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.back {
  position: absolute;
  left: 28rpx;

  color: #173C34;
  font-size: 58rpx;
}

.title {
  color: #173C34;

  font-size: 36rpx;
  font-weight: bold;
}


/* 卡片 */
.card {
  margin: 0 24rpx 20rpx;

  padding: 26rpx;

  border-radius: 28rpx;

  background: white;

  box-shadow: 0 8rpx 25rpx rgba(31,70,60,.04);
}


/* 当前投票 */
.current-card {
  border: 2rpx solid #E5EEE8;
}

.card-head {
  display: flex;

  justify-content: space-between;
  align-items: flex-start;
}

.section-title {
  display: block;

  color: #24483F;

  font-size: 28rpx;
  font-weight: bold;
}

.section-subtitle {
  display: block;

  margin-top: 5rpx;

  color: #95A39D;

  font-size: 19rpx;
}

.status {
  padding: 7rpx 14rpx;

  border-radius: 18rpx;

  background: #E5F1EB;

  color: #1F6A57;

  font-size: 19rpx;
  font-weight: bold;
}

.poll-title {
  margin-top: 22rpx;

  color: #233F36;

  font-size: 31rpx;
  font-weight: bold;
}

.poll-description {
  margin-top: 8rpx;

  color: #788983;

  font-size: 21rpx;

  line-height: 1.6;
}


/* 我的选择 */
.my-choice {
  margin-top: 20rpx;

  padding: 18rpx;

  border-radius: 20rpx;

  background: #F1F5F2;

  display: flex;

  justify-content: space-between;
  align-items: center;
}

.choice-label {
  color: #74837D;

  font-size: 20rpx;
}

.choice-name {
  color: #1F6A57;

  font-size: 25rpx;
  font-weight: bold;
}


/* 结果 */
.result-list {
  margin-top: 25rpx;
}

.result-item {
  margin-bottom: 21rpx;
}

.result-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 9rpx;
}

.result-name {
  color: #425A52;

  font-size: 22rpx;
}

.result-number {
  display: flex;
  align-items: baseline;

  color: #1F6A57;

  font-size: 21rpx;
  font-weight: bold;
}

.result-count {
  margin-left: 8rpx;

  color: #9BA7A2;

  font-size: 18rpx;
  font-weight: normal;
}

.poll-footer {
  display: flex;

  justify-content: space-between;

  margin-top: 8rpx;

  color: #9AA6A1;

  font-size: 18rpx;
}


/* 历史 */
.history-title {
  margin: 25rpx 28rpx 16rpx;

  color: #536B62;

  font-size: 27rpx;
  font-weight: bold;
}

.history-card {
  margin-bottom: 16rpx;
}

.history-head {
  display: flex;

  justify-content: space-between;
  align-items: flex-start;
}

.history-poll-title {
  display: block;

  color: #304B42;

  font-size: 24rpx;
  font-weight: bold;
}

.history-date {
  display: block;

  margin-top: 6rpx;

  color: #9AA6A1;

  font-size: 18rpx;
}

.ended-tag {
  padding: 6rpx 12rpx;

  border-radius: 16rpx;

  background: #F0F2F1;

  color: #84908B;

  font-size: 18rpx;
}

.history-choice,
.history-result,
.history-summary {
  display: flex;

  justify-content: space-between;
  align-items: center;

  margin-top: 18rpx;

  color: #7A8983;

  font-size: 20rpx;
}

.history-choice-name {
  color: #1F6A57;

  font-weight: bold;
}

.history-result-name {
  color: #476158;

  font-weight: bold;
}

.history-summary {
  margin-top: 15rpx;
  padding-top: 15rpx;

  border-top: 1rpx solid #EDF0EE;

  color: #9AA6A1;
}


/* 空 */
.empty {
  padding-top: 180rpx;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 86rpx;
}

.empty-title {
  margin-top: 22rpx;

  color: #405950;

  font-size: 28rpx;
  font-weight: bold;
}

.empty-text {
  width: 500rpx;

  margin-top: 9rpx;

  text-align: center;

  color: #95A19C;

  font-size: 20rpx;

  line-height: 1.6;
}

.go-poll {
  width: 240rpx;
  height: 76rpx;

  margin-top: 30rpx;

  line-height: 76rpx;

  border-radius: 40rpx;

  background: #1F6A57;
  color: white;

  font-size: 24rpx;
}

button::after {
  border: none;
}