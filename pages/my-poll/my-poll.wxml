<view class="page">

<!-- =========================
     顶部
========================== -->

<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <text class="title">
    我的投票
  </text>

</view>


<!-- =========================
     当前进行中的投票
========================== -->

<view
  wx:if="{{activePolls.length > 0}}"
  class="history-title"
>
  当前投票
</view>


<view
  wx:for="{{activePolls}}"
  wx:key="id"
  class="card current-card"
>

  <!-- 头部 -->

  <view class="card-head">

    <view>

      <text class="section-title">
        正在进行
      </text>

      <text class="section-subtitle">
        食客共创投票
      </text>

    </view>


    <text class="status">
      {{item.statusName}}
    </text>

  </view>


  <!-- 标题 -->

  <view class="poll-title">
    {{item.title}}
  </view>


  <!-- 说明 -->

  <view
    wx:if="{{item.description}}"
    class="poll-description"
  >
    {{item.description}}
  </view>


  <!-- 我的选择 -->

  <view class="my-choice">

    <text class="choice-label">
      我的选择
    </text>

    <text class="choice-name">
      {{item.myChoice}}
    </text>

  </view>


  <!-- 投票结果 -->

  <view class="result-list">

    <view
      wx:for="{{item.options}}"
      wx:for-item="option"
      wx:key="id"
      class="result-item"
    >

      <view class="result-top">

        <text class="result-name">
          {{option.name}}
        </text>

        <view class="result-number">

          <text>
            {{option.percent}}%
          </text>

          <text class="result-count">
            {{option.votes}}票
          </text>

        </view>

      </view>


      <progress
        percent="{{option.percent}}"
        activeColor="#1F6A57"
        backgroundColor="#E8EEEB"
        stroke-width="10"
        active
      />

    </view>

  </view>


  <!-- 底部信息 -->

  <view class="poll-footer">

    <text>
      共 {{item.totalVotes}} 人参与
    </text>


    <text wx:if="{{item.endDate}}">
      截止 {{item.endDate}}
    </text>

  </view>


  <!-- 尚未投票 -->

  <button
    wx:if="{{!item.hasVoted}}"
    class="go-poll"
    bindtap="goPoll"
    data-poll-id="{{item.id}}"
  >
    去投票
  </button>


  <!-- 已经投票 -->

  <view
    wx:if="{{item.hasVoted}}"
    class="voted-tip"
  >
    ✓ 你已经参与这场投票
  </view>

</view>


<!-- =========================
     历史投票
========================== -->

<view
  wx:if="{{historyPolls.length > 0}}"
  class="history-title"
>
  历史投票
</view>


<view
  wx:for="{{historyPolls}}"
  wx:key="id"
  class="card history-card"
>

  <!-- 标题 -->

  <view class="history-head">

    <view>

      <text class="history-poll-title">
        {{item.title}}
      </text>

      <text class="history-date">
        {{item.date}}
      </text>

    </view>


    <text class="ended-tag">
      {{item.statusName}}
    </text>

  </view>


  <!-- 我的选择 -->

  <view class="history-choice">

    <text>
      我的选择
    </text>

    <text class="history-choice-name">
      {{item.myChoice}}
    </text>

  </view>


  <!-- 最终结果 -->

  <view class="history-result">

    <text>
      最终结果
    </text>

    <view>

<text class="history-result-name">
  {{item.winner}}
</text>

<text
  wx:if="{{item.isTie}}"
  class="winner-tag"
>
  并列第一
</text>

</view>

  </view>


  <!-- 参与人数 -->

  <view class="history-summary">

    <text>
      {{item.totalVotes || 0}} 人参与
    </text>

    <text>
      {{item.resultPercent || 0}}%
    </text>

  </view>

</view>


<!-- =========================
     没有进行中的投票
========================== -->

<view
  wx:if="{{activePolls.length === 0 && historyPolls.length === 0}}"
  class="empty"
>

  <text class="empty-icon">
    🗳️
  </text>

  <text class="empty-title">
    还没有参与过投票
  </text>

  <text class="empty-text">
    去参加投票，为餐厅新品出一份力吧
  </text>


  <button
    class="go-poll"
    bindtap="goPoll"
  >
    去看看投票
  </button>

</view>


<!-- =========================
     页面说明
========================== -->

<view class="info-card">

  <view class="info-title">
    💡 食客共创
  </view>

  <view class="info-text">
    每场投票都会独立记录你的选择。
  </view>

  <view class="info-text">
    你可以连续参与不同的共创投票。
  </view>

</view>

</view>