<view class="page">

<!-- 顶部 -->

<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <text class="title">
    食客投票
  </text>

  <view class="header-more">
    ···
  </view>

</view>


<!-- 多个投票 -->

<view
  wx:for="{{polls}}"
  wx:key="id"
  class="poll-card"
>

  <!-- 投票图片 -->

  <image
    class="poll-image"
    src="/images/food2.jpg"
    mode="aspectFill"
  />


  <!-- 状态 -->

  <view class="poll-tag">

    {{item.status === 'active'
      ? '进行中'
      : item.statusName}}

  </view>


  <!-- 标题 -->

  <view class="poll-title">
    {{item.title}}
  </view>


  <!-- 说明 -->

  <view
    wx:if="{{item.description}}"
    class="poll-desc"
  >
    {{item.description}}
  </view>


  <!-- 信息 -->

  <view class="poll-info">

    <text>
      {{item.totalVotes || 0}} 人已参与
    </text>

    <text wx:if="{{item.status === 'active' && item.endDate}}">
      截止 {{item.endDate}}
    </text>

    <text wx:if="{{item.status !== 'active' && item.endTime}}">
      已结束 {{item.endTime}}
    </text>

  </view>


  <!-- =========================
       未投票
  ========================== -->

  <view
    wx:if="{{item.status === 'active' && !item.hasVoted}}"
    class="card"
  >

    <view class="card-title">
      请选择你最期待的选项
    </view>


    <view class="options">

      <view
        wx:for="{{item.options}}"
        wx:for-item="option"
        wx:key="id"

        class="option {{item.selectedId === option.id ? 'selected' : ''}}"

        data-poll-id="{{item.id}}"

        data-option-id="{{option.id}}"

        bindtap="selectOption"
      >

        <view class="radio">

          <view
            wx:if="{{item.selectedId === option.id}}"
            class="radio-dot"
          ></view>

        </view>


        <view class="option-info">

          <text class="option-name">
            {{option.name}}
          </text>

          <text
            wx:if="{{option.desc}}"
            class="option-desc"
          >
            {{option.desc}}
          </text>

        </view>

      </view>

    </view>


    <button
      class="vote-btn"

      data-poll-id="{{item.id}}"

      bindtap="submitVote"
    >
      立即投票
    </button>

  </view>


  <!-- =========================
       已投票 / 已结束
  ========================== -->

  <view
    wx:if="{{item.status !== 'active' || item.hasVoted}}"
    class="card result-card"
  >

    <view
      wx:if="{{item.hasVoted}}"
      class="voted-tip"
    >
      ✓ 感谢你的参与
    </view>


    <view
      wx:if="{{item.status === 'ended'}}"
      class="voted-tip"
    >
      投票已结束
    </view>


    <view
      wx:if="{{item.status === 'accepted'}}"
      class="voted-tip"
    >
      ✓ 这条建议已采纳
    </view>


    <view
      wx:if="{{item.status === 'rejected'}}"
      class="voted-tip"
    >
      这条建议暂不采纳
    </view>


    <view class="voted-desc">

      {{item.hasVoted
        ? '下面是当前投票结果'
        : '下面是最终投票结果'}}

    </view>


    <view class="result-list">

      <view
        wx:for="{{item.options}}"
        wx:for-item="option"
        wx:key="id"

        class="result-item"
      >

        <view class="result-top">

          <text class="result-name">
            {{option.name}}
          </text>

          <view class="result-number">

            <text>
              {{option.percent}}%
            </text>

            <text class="result-count">
              （{{option.votes}}票）
            </text>

          </view>

        </view>


        <progress

          percent="{{option.percent}}"

          activeColor="#1F6A57"

          backgroundColor="#E7ECE9"

          stroke-width="10"

          active

        />

      </view>

    </view>


    <view class="total-votes">
      当前共有 {{item.totalVotes || 0}} 人参与
    </view>

  </view>


</view>


<!-- 没有投票 -->

<view
  wx:if="{{polls.length === 0}}"
  class="empty"
>

  <text class="empty-icon">
    🗳️
  </text>

  <text class="empty-title">
    暂时没有可参与的投票
  </text>

  <text class="empty-text">
    商家发布新的共创投票后，会显示在这里
  </text>

</view>


<!-- 投票说明 -->

<view class="info-card">

  <view class="info-title">
    💡 食客共创
  </view>

  <view class="info-text">
    每一场投票都对应一次真实的食客共创建议。
  </view>

  <view class="info-text">
    你可以连续参与不同投票，为餐厅新品提供意见。
  </view>

</view>


<!-- 查看留言 -->

<view
  class="community-link"
  bindtap="goCommunity"
>
  想详细讨论？去看看食客留言 ›
</view>

</view>