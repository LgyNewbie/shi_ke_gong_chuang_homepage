<view class="page">

<!-- 顶部 -->
<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <text class="title">
    本周投票
  </text>

  <view class="header-more">
    ···
  </view>

</view>


<!-- 投票主题 -->
<view class="poll-card">

  <image
    class="poll-image"
    src="/images/food2.jpg"
    mode="aspectFill"
  />

  <view class="poll-tag">
    进行中
  </view>

  <view class="poll-title">
    {{poll.title}}
  </view>

  <view class="poll-desc">
    {{poll.description}}
  </view>

  <view class="poll-info">

    <text>
      {{poll.totalVotes}} 人已参与
    </text>

    <text>
      截止 {{poll.endDate}}
    </text>

  </view>

</view>


<!-- 还没有投票 -->
<view
  wx:if="{{!hasVoted}}"
  class="card"
>

  <view class="card-title">
    请选择你最期待的新品
  </view>


  <view class="options">

    <view
      wx:for="{{poll.options}}"
      wx:key="id"
      class="option {{selectedId === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectOption"
    >

      <view class="radio">
        <view
          wx:if="{{selectedId === item.id}}"
          class="radio-dot"
        >
        </view>
      </view>

      <view class="option-info">

        <text class="option-name">
          {{item.name}}
        </text>

        <text class="option-desc">
          {{item.desc}}
        </text>

      </view>

    </view>

  </view>


  <button
    class="vote-btn"
    bindtap="submitVote"
  >
    立即投票
  </button>

</view>


<!-- 已投票 -->
<view
  wx:if="{{hasVoted}}"
  class="card result-card"
>

  <view class="voted-tip">
    ✓ 感谢你的参与
  </view>

  <view class="voted-desc">
    你已经完成本周投票，下面是当前结果
  </view>


  <view class="result-list">

    <view
      wx:for="{{poll.options}}"
      wx:key="id"
      class="result-item"
    >

      <view class="result-top">

        <text class="result-name">
          {{item.name}}
        </text>

        <view class="result-number">
          <text>{{item.percent}}%</text>
          <text class="result-count">
            （{{item.votes}}票）
          </text>
        </view>

      </view>

      <progress
        percent="{{item.percent}}"
        activeColor="#1F6A57"
        backgroundColor="#E7ECE9"
        stroke-width="10"
        active
      />

    </view>

  </view>


  <view class="total-votes">
    当前共有 {{poll.totalVotes}} 人参与
  </view>

</view>


<!-- 投票说明 -->
<view class="info-card">

  <view class="info-title">
    💡 食客共创
  </view>

  <view class="info-text">
    你的每一次投票，都可能影响餐厅下一款新品。
  </view>

  <view class="info-text">
    商家会根据投票结果和食客留言决定后续菜单。
  </view>

</view>


<!-- 查看留言 -->
<view
  class="community-link"
  bindtap="goCommunity"
>
  想详细讨论？去看看食客留言 ›
</view>

</view>