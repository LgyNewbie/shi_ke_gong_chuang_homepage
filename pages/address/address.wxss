page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}


/* 顶部 */
.header {
  height: 115rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.back {
  position: absolute;
  left: 28rpx;

  color: #173C34;
  font-size: 58rpx;
}

.title {
  color: #173C34;
  font-size: 35rpx;
  font-weight: bold;
}

.add-top {
  position: absolute;
  right: 28rpx;

  width: 58rpx;
  height: 58rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #1F6A57;
  color: white;

  font-size: 35rpx;
}


/* 地址列表 */
.address-list {
  padding: 0 24rpx;
}

.address-card {
  margin-bottom: 18rpx;

  padding: 24rpx;

  background: white;

  border-radius: 28rpx;

  box-shadow: 0 8rpx 25rpx rgba(31,70,60,.05);
}

.address-main {
  position: relative;

  padding-right: 10rpx;
}

.default-tag {
  display: inline-block;

  margin-bottom: 10rpx;

  padding: 5rpx 11rpx;

  background: #E4F1EA;

  color: #1F6A57;

  border-radius: 10rpx;

  font-size: 18rpx;
}

.contact-row {
  display: flex;
  align-items: center;
}

.name {
  color: #294940;

  font-size: 27rpx;
  font-weight: bold;
}

.phone {
  margin-left: 18rpx;

  color: #74847E;

  font-size: 21rpx;
}

.address-text {
  display: block;

  margin-top: 10rpx;

  color: #64766F;

  font-size: 22rpx;

  line-height: 1.65;
}

.address-actions {
  display: flex;

  justify-content: flex-end;

  margin-top: 20rpx;
  padding-top: 17rpx;

  border-top: 1rpx solid #EDF0EE;
}

.action {
  margin-left: 28rpx;

  color: #71817B;

  font-size: 20rpx;
}

.delete-action {
  color: #C77864;
}


/* 空 */
.empty {
  padding-top: 180rpx;

  display: flex;
  flex-direction: column;

  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  margin-top: 22rpx;

  color: #3C574E;

  font-size: 29rpx;
  font-weight: bold;
}

.empty-text {
  margin-top: 9rpx;

  color: #929F99;

  font-size: 21rpx;
}

.empty-btn {
  width: 250rpx;
  height: 76rpx;

  margin-top: 30rpx;

  line-height: 76rpx;

  border-radius: 40rpx;

  background: #1F6A57;
  color: white;

  font-size: 24rpx;
}


/* 底部 */
.bottom {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  padding: 18rpx 24rpx 28rpx;

  background: rgba(247,245,239,.97);
}

.add-btn {
  height: 80rpx;

  margin: 0;

  line-height: 80rpx;

  border-radius: 42rpx;

  background: #1F6A57;
  color: white;

  font-size: 25rpx;
  font-weight: bold;
}

button::after {
  border: none;
}