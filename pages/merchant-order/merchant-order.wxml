<view class="page">

<!-- 顶部 -->
<view class="header">

  <view>
    <view class="title">
      订单管理
    </view>

    <view class="subtitle">
      食客共创 · 商家后台
    </view>
  </view>

</view>


<!-- 状态统计 -->
<view class="stats">

  <view class="stat-card">
    <view class="stat-number">
      {{pendingCount}}
    </view>
    <view class="stat-label">
      待处理
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{acceptedCount}}
    </view>
    <view class="stat-label">
      已接单
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{cookingCount}}
    </view>
    <view class="stat-label">
      制作中
    </view>
  </view>

  <view class="stat-card">
    <view class="stat-number">
      {{deliveryCount}}
    </view>
    <view class="stat-label">
      配送中
    </view>
  </view>

</view>


<!-- 分类 -->
<scroll-view
  class="tabs-scroll"
  scroll-x
>

  <view class="tabs">

    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{currentTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </view>

  </view>

</scroll-view>


<!-- 订单列表 -->
<view class="order-list">

  <view
    wx:for="{{filteredOrders}}"
    wx:key="id"
    class="order-card"
  >

    <!-- 订单头 -->
    <view class="order-head">

      <view class="order-number">
        {{item.id}}
      </view>

      <view class="status">
        {{item.statusName}}
      </view>

    </view>


    <!-- 配送方式 -->
    <view class="delivery-type">

      <text
        wx:if="{{item.deliveryType === 'delivery'}}"
      >
        🚚 外卖配送
      </text>

      <text
        wx:if="{{item.deliveryType === 'pickup'}}"
      >
        🏪 到店自取
      </text>

    </view>


    <!-- 地址 -->
    <view
      wx:if="{{item.deliveryType === 'delivery' && item.address}}"
      class="address-box"
    >

      <view class="address-name">
        {{item.address.name}}
        <text>
          {{item.address.phone}}
        </text>
      </view>

      <view class="address-detail">
        {{item.address.detail}}
      </view>

    </view>


    <!-- 商品 -->
    <view class="food-list">

      <view
        wx:for="{{item.items}}"
        wx:for-item="food"
        wx:key="id"
        class="food-row"
      >

        <view class="food-name">
          {{food.name}}
        </view>

        <view class="food-count">
          × {{food.count}}
        </view>

        <view class="food-price">
          ¥{{food.price * food.count}}
        </view>

      </view>

    </view>


    <!-- 备注 -->
    <view
      wx:if="{{item.remark}}"
      class="remark"
    >
      备注：{{item.remark}}
    </view>


    <!-- 总价 -->
    <view class="order-bottom">

      <view class="order-time">
        {{item.createTime}}
      </view>

      <view class="total">
        ¥{{item.total}}
      </view>

    </view>


    <!-- 操作 -->
    <view class="actions">

      <!-- 待接单：顾客还没有付款 -->
<view
  wx:if="{{item.status === 'pending' && item.paymentStatus !== 'paid'}}"
  class="disabled-btn"
>
  等待顾客付款
</view>

<!-- 待接单：顾客已经付款 -->
<view
  wx:if="{{item.status === 'pending' && item.paymentStatus === 'paid'}}"
  class="action-btn"
  data-id="{{item.id}}"
  data-status="accepted"
  bindtap="changeStatus"
>
  接单
</view>


      <!-- 已接单 -->
      <view
        wx:if="{{item.status === 'accepted'}}"
        class="action-btn"
        data-id="{{item.id}}"
        data-status="cooking"
        bindtap="changeStatus"
      >
        开始制作
      </view>


      <!-- 制作中：外卖配送 -->
<view
  wx:if="{{item.status === 'cooking' && item.deliveryType === 'delivery'}}"
  class="action-btn"
  data-id="{{item.id}}"
  data-status="delivery"
  bindtap="changeStatus"
>
  开始配送
</view>

<!-- 制作中：到店自取 -->
<view
  wx:if="{{item.status === 'cooking' && item.deliveryType === 'pickup'}}"
  class="action-btn"
  data-id="{{item.id}}"
  data-status="ready"
  bindtap="changeStatus"
>
  制作完成
</view>


      <!-- 配送中 -->
      <view
        wx:if="{{item.status === 'delivery'}}"
        class="action-btn"
        data-id="{{item.id}}"
        data-status="completed"
        bindtap="changeStatus"
      >
        完成订单
      </view>

<!-- 待取餐 -->
<view
  wx:if="{{item.status === 'ready'}}"
  class="action-btn"
  data-id="{{item.id}}"
  data-status="completed"
  bindtap="changeStatus"
>
  顾客已取餐
</view>


      <!-- 已完成 -->
      <view
        wx:if="{{item.status === 'completed'}}"
        class="completed-btn"
      >
        已完成
      </view>


      <!-- 已取消 -->
      <view
        wx:if="{{item.status === 'cancelled'}}"
        class="cancelled-btn"
      >
        已取消
      </view>

    </view>

  </view>

</view>


<!-- 空状态 -->
<view
  wx:if="{{filteredOrders.length === 0}}"
  class="empty"
>

  <view class="empty-icon">
    📦
  </view>

  <view class="empty-title">
    暂无订单
  </view>

  <view class="empty-text">
    当前分类下还没有订单
  </view>

</view>

</view>