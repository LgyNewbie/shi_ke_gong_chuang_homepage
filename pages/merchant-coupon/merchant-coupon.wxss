/* pages/merchant-coupon/merchant-coupon.wxss */

page {
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  background: #ffffff;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.add-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #ff6b00;
  color: #ffffff;
  font-size: 27rpx;
}


/* 优惠券列表 */
.coupon-list {
  padding: 24rpx;
}

.coupon-card {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}

.coupon-main {
  position: relative;
  display: flex;
  min-height: 190rpx;
  padding: 28rpx;
}

.coupon-left {
  width: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-right: 2rpx dashed #eeeeee;
}

.coupon-amount {
  display: flex;
  align-items: baseline;
  color: #ff5a36;
}

.amount-symbol {
  font-size: 30rpx;
  font-weight: 600;
}

.amount {
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-condition {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #888888;
}

.coupon-info {
  flex: 1;
  padding: 4rpx 20rpx 0 26rpx;
  min-width: 0;
}

.coupon-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.promotion-name {
  display: inline-block;
  margin-top: 10rpx;
  padding: 5rpx 10rpx;
  background: #fff1e6;
  border-radius: 6rpx;
  font-size: 21rpx;
  color: #ff6b00;
}

.coupon-time {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

.coupon-count {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #666666;
}

.used-count {
  margin-left: 20rpx;
  color: #999999;
}


/* 发放状态 */
.issue-status {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #eaf8ef;
  color: #20a35a;
  font-size: 21rpx;
}

.issue-status.stopped {
  background: #f3f3f3;
  color: #999999;
}

.issue-status.finished {
  background: #fff4e5;
  color: #e58a00;
}


/* 操作按钮 */
.coupon-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  margin: 0;
  min-width: 120rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dddddd;
  border-radius: 10rpx;
  background: #ffffff;
  color: #555555;
  font-size: 23rpx;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  border-color: #ff6b00;
  background: #ff6b00;
  color: #ffffff;
}

.action-btn.warning {
  border-color: #f0a020;
  background: #fff5e5;
  color: #d88600;
}

.action-btn.danger {
  border-color: #ff8c7a;
  color: #f05a43;
}

.action-btn.delete-btn {
  color: #999999;
}


/* 空状态 */
.empty {
  margin: 80rpx 40rpx;
  padding: 70rpx 30rpx;
  background: #ffffff;
  border-radius: 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 30rpx;
  width: 260rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff6b00;
  color: #ffffff;
  font-size: 27rpx;
}

.empty-btn::after {
  border: none;
}


/* 弹窗遮罩 */
.mask {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.form-panel {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  overflow-y: auto;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222222;
}

.close {
  width: 54rpx;
  height: 54rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 46rpx;
  color: #999999;
}


/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafafa;
  font-size: 26rpx;
  color: #333333;
}

.input-row {
  display: flex;
  align-items: center;
}

.number-input {
  flex: 1;
}

.unit {
  width: 60rpx;
  text-align: right;
  font-size: 25rpx;
  color: #666666;
}

.tip {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #999999;
}


/* 表单底部 */
.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.cancel-btn,
.save-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f3f3f3;
  color: #555555;
}

.save-btn {
  background: #ff6b00;
  color: #ffffff;
}

.cancel-btn::after,
.save-btn::after {
  border: none;
}