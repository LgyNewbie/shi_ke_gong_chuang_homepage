<view class="page">

<!-- 顶部图片 -->
<view class="hero">

  <image
    class="hero-image"
    src="{{food.image}}"
    mode="aspectFill"
  />

  <view
    class="back-button"
    bindtap="goBack"
  >
    ‹
  </view>

  <view
    class="favorite-button {{isFavorite ? 'active' : ''}}"
    bindtap="toggleFavorite"
  >
    {{isFavorite ? '♥' : '♡'}}
  </view>

</view>


<!-- 商品基本信息 -->
<view
  wx:if="{{food}}"
  class="content"
>

  <view class="title-row">

    <view class="title-box">

      <text class="food-name">
        {{food.name}}
      </text>

      <text
        wx:if="{{food.hot}}"
        class="hot-tag"
      >
        热销
      </text>

    </view>

  </view>


  <text class="food-desc">
    {{food.desc}}
  </text>


  <!-- 价格和销量 -->
  <view class="price-row">

    <view class="price-box">

      <text class="price-symbol">
        ¥
      </text>

      <text class="price">
        {{food.price}}
      </text>

    </view>

    <text class="sales">
      已售 {{food.sales}}
    </text>

  </view>


  <!-- 商品详情 -->
  <view class="detail-card">

    <view class="section-title">
      商品信息
    </view>


    <view class="detail-row">

      <text class="detail-label">
        食材
      </text>

      <text class="detail-value">
        {{food.ingredients}}
      </text>

    </view>


    <view class="detail-row">

      <text class="detail-label">
        口味
      </text>

      <text class="detail-value">
        {{food.taste}}
      </text>

    </view>


    <view class="detail-row">

      <text class="detail-label">
        分量
      </text>

      <text class="detail-value">
        {{food.weight}}
      </text>

    </view>


    <view
      wx:if="{{food.allergen}}"
      class="detail-row"
    >

      <text class="detail-label">
        提示
      </text>

      <text class="detail-value warning">
        {{food.allergen}}
      </text>

    </view>

  </view>


  <!-- 商品说明 -->
  <view class="intro-card">

    <view class="section-title">
      菜品介绍
    </view>

    <text class="intro-text">
      {{food.desc}}
    </text>

  </view>

</view>

<!-- 用户评价 -->
<view class="review-card">

<view class="review-header">

  <view class="section-title">
    用户评价
  </view>

  <view wx:if="{{reviewCount > 0}}" class="review-summary">

    <text class="review-score">
      {{averageRating}}
    </text>

    <text class="review-star">
      ★
    </text>

    <text class="review-count">
      {{reviewCount}}条评价
    </text>

  </view>

</view>

<!-- 没有评价 -->
<view
  wx:if="{{reviewCount === 0}}"
  class="empty-review"
>
  暂无评价，购买后可以发表你的第一条评价
</view>

<!-- 评价列表 -->
<view
  wx:else
  class="review-list"
>

  <view
    wx:for="{{reviews}}"
    wx:key="id"
    class="review-item"
  >

    <view class="review-top">

      <view class="review-user">
        {{item.userName}}
      </view>

      <view class="review-stars">

        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          wx:for-item="star"
          class="{{star <= item.rating ? 'active' : ''}}"
        >
          ★
        </text>

      </view>

    </view>

    <view class="review-content">
      {{item.content}}
    </view>

    <view class="review-time">
      {{item.createTime}}
    </view>

  </view>

</view>

</view>


<!-- 底部操作栏 -->
<view
  wx:if="{{food}}"
  class="bottom-bar"
>

  <view
    class="bottom-cart"
    bindtap="openCart"
  >
    🛒
  </view>


  <view class="bottom-price">

    <text class="bottom-price-symbol">
      ¥
    </text>

    <text class="bottom-price-number">
      {{food.price}}
    </text>

  </view>


  <view
    class="add-cart-button"
    bindtap="addToCart"
  >
    加入购物车
  </view>

</view>

</view>