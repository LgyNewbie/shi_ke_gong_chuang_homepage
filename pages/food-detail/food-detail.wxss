page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}


/* 顶部图片 */

.hero {
  position: relative;

  width: 100%;
  height: 520rpx;

  background: #E9EEEB;
}

.hero-image {
  width: 100%;
  height: 100%;
}


/* 返回按钮 */

.back-button {
  position: absolute;

  top: 32rpx;
  left: 26rpx;

  width: 72rpx;
  height: 72rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.92);

  color: #28483F;

  font-size: 52rpx;

  line-height: 1;
}


/* 收藏 */

.favorite-button {
  position: absolute;

  top: 32rpx;
  right: 26rpx;

  width: 72rpx;
  height: 72rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.92);

  color: #91A099;

  font-size: 40rpx;
}

.favorite-button.active {
  background: #FFF0EA;
  color: #DF6A43;
}


/* 内容 */

.content {
  margin-top: -28rpx;

  position: relative;

  padding: 34rpx 28rpx 40rpx;

  border-radius: 32rpx 32rpx 0 0;

  background: #F7F5EF;
}


/* 标题 */

.title-row {
  display: flex;
  align-items: center;
}

.title-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.food-name {
  color: #203F35;

  font-size: 38rpx;

  font-weight: bold;
}

.hot-tag {
  margin-left: 14rpx;

  padding: 6rpx 12rpx;

  border-radius: 10rpx;

  background: #FFF0DF;

  color: #DD7B3A;

  font-size: 19rpx;
}


/* 简介 */

.food-desc {
  display: block;

  margin-top: 12rpx;

  color: #82908B;

  font-size: 23rpx;

  line-height: 1.6;
}


/* 价格 */

.price-row {
  margin-top: 22rpx;

  display: flex;

  align-items: baseline;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  color: #E16C42;

  font-size: 24rpx;
}

.price {
  margin-left: 4rpx;

  color: #E16C42;

  font-size: 48rpx;

  font-weight: bold;
}

.sales {
  margin-left: 16rpx;

  color: #9BA7A2;

  font-size: 20rpx;
}


/* 卡片 */

.detail-card,
.intro-card {
  margin-top: 28rpx;

  padding: 26rpx;

  border-radius: 24rpx;

  background: #FFFFFF;

  box-shadow: 0 8rpx 25rpx rgba(31,65,55,.04);
}

.section-title {
  color: #24483F;

  font-size: 28rpx;

  font-weight: bold;

  margin-bottom: 18rpx;
}


/* 详情 */

.detail-row {
  display: flex;

  padding: 13rpx 0;

  border-bottom: 1rpx solid #EEF1EF;

  font-size: 22rpx;

  line-height: 1.6;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  width: 90rpx;

  flex-shrink: 0;

  color: #71817B;
}

.detail-value {
  flex: 1;

  color: #40584F;
}

.warning {
  color: #C87942;
}


/* 菜品介绍 */

.intro-text {
  display: block;

  color: #60736B;

  font-size: 22rpx;

  line-height: 1.8;
}


/* 底部 */

.bottom-bar {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 100;

  height: 120rpx;

  padding: 0 28rpx;

  display: flex;

  align-items: center;

  background: #FFFFFF;

  box-shadow: 0 -8rpx 25rpx rgba(31,65,55,.08);
}

.bottom-cart {
  width: 72rpx;
  height: 72rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #EEF3F0;

  font-size: 34rpx;
}

.bottom-price {
  margin-left: 20rpx;

  display: flex;
  align-items: baseline;
}

.bottom-price-symbol {
  color: #E16C42;

  font-size: 22rpx;
}

.bottom-price-number {
  margin-left: 3rpx;

  color: #E16C42;

  font-size: 36rpx;

  font-weight: bold;
}

.add-cart-button {
  margin-left: auto;

  width: 270rpx;
  height: 76rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 40rpx;

  background: #1F6A57;

  color: #FFFFFF;

  font-size: 26rpx;

  font-weight: bold;
}