page {
  background: #F6F8F7;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}


/* 订单信息 */

.order-card,
.form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-title,
.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #243B33;
  margin-bottom: 20rpx;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 24rpx;
  color: #87938E;
}

.value {
  max-width: 70%;
  font-size: 24rpx;
  color: #50665D;
  word-break: break-all;
}


/* 投诉类型 */

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  background: #F1F4F2;
  color: #50665D;
  font-size: 24rpx;
}

.type-item.active {
  background: #1F6A57;
  color: #FFFFFF;
}


/* 投诉内容 */

.content-input {
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #F8F9F8;
  color: #243B33;
  font-size: 25rpx;
  line-height: 1.6;
}

.word-count {
  margin-top: 12rpx;
  text-align: right;
  color: #A0AAA5;
  font-size: 21rpx;
}


/* 图片 */

.image-tip {
  margin-bottom: 18rpx;
  color: #87938E;
  font-size: 22rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.image-item,
.add-image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

.delete-image {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  text-align: center;
  line-height: 38rpx;
  font-size: 30rpx;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F4F6F5;
  border: 2rpx dashed #CDD6D1;
  box-sizing: border-box;
}

.add-image-icon {
  font-size: 54rpx;
  line-height: 60rpx;
  color: #87938E;
}

.add-image-text {
  margin-top: 8rpx;
  color: #87938E;
  font-size: 22rpx;
}


/* 提交 */

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1F6A57;
  color: #FFFFFF;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.bottom-tip {
  text-align: center;
  margin: 20rpx 0 40rpx;
  color: #A0AAA5;
  font-size: 21rpx;
}
/* =========================
   再次投诉提示
========================= */

.recomplaint-tip {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  border: 1rpx solid #f5dfb0;
  box-sizing: border-box;
}

.recomplaint-tip-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.recomplaint-tip-content {
  margin-left: 16rpx;
  flex: 1;
}

.recomplaint-tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8a5a00;
}

.recomplaint-tip-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a6b32;
}