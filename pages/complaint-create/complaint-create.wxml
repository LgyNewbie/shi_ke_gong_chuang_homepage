<view class="page">

<!-- 订单信息 -->
<view class="order-card">

  <view class="card-title">
    投诉订单
  </view>

  <view class="order-row">
    <text class="label">订单号</text>
    <text class="value">{{orderId}}</text>
  </view>

</view>

<!-- 再次投诉提示 -->

<view
  wx:if="{{isReComplaint}}"
  class="recomplaint-tip"
>

  <view class="recomplaint-tip-icon">
    🔄
  </view>

  <view class="recomplaint-tip-content">

    <view class="recomplaint-tip-title">
      再次投诉
    </view>

    <view class="recomplaint-tip-text">
      这是针对该订单的再次投诉，请补充新的投诉内容。
    </view>

  </view>

</view>

<!-- 投诉类型 -->
<view class="form-card">

  <view class="form-title">
    投诉类型
  </view>

  <view class="type-list">

    <view
      wx:for="{{complaintTypes}}"
      wx:key="*this"
      class="type-item {{type === item ? 'active' : ''}}"
      data-type="{{item}}"
      bindtap="selectType"
    >
      {{item}}
    </view>

  </view>

</view>


<!-- 投诉内容 -->
<view class="form-card">

  <view class="form-title">
    投诉内容
  </view>

  <textarea
    class="content-input"
    placeholder="请详细描述您遇到的问题，例如商品质量、服务态度等"
    maxlength="500"
    value="{{content}}"
    bindinput="onContentInput"
  />

  <view class="word-count">
    {{content.length}} / 500
  </view>

</view>


<!-- 图片 -->
<view class="form-card">

  <view class="form-title">
    添加图片
  </view>

  <view class="image-tip">
    可上传相关图片，帮助商家了解问题
  </view>

  <view class="image-list">

    <view
      wx:for="{{images}}"
      wx:key="*this"
      class="image-item"
    >

      <image
        class="preview-image"
        src="{{item}}"
        mode="aspectFill"
        bindtap="previewImage"
        data-url="{{item}}"
      />

      <view
        class="delete-image"
        bindtap="deleteImage"
        data-index="{{index}}"
      >
        ×
      </view>

    </view>


    <view
      wx:if="{{images.length < 6}}"
      class="add-image"
      bindtap="chooseImages"
    >
      <text class="add-image-icon">＋</text>
      <text class="add-image-text">添加图片</text>
    </view>

  </view>

</view>


<!-- 提交 -->
<button
  class="submit-btn"
  bindtap="submitComplaint"
  loading="{{submitting}}"
  disabled="{{submitting}}"
>
  {{submitting
    ? '提交中...'
    : (isReComplaint ? '提交再次投诉' : '提交投诉')
  }}
</button>


<view class="bottom-tip">
  您提交的投诉将发送给餐厅处理
</view>

</view>