<view class="page">

<!-- 顶部 -->

<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <text class="title">
    商家处理
  </text>

</view>


<!-- 用户真实留言 -->

<view
  wx:if="{{message}}"
  class="message-card"
>

  <view class="user-row">

    <view class="avatar-text">
      {{message.name ? message.name.slice(0, 1) : '食'}}
    </view>

    <view class="user-info">

      <text class="name">
        {{message.name || '食客'}}
      </text>

      <text class="time">
        {{message.time || '刚刚'}}
      </text>

    </view>

    <text class="tag">
      {{message.category || message.tag || '其他'}}
    </text>

  </view>


  <view class="message-text">
    {{message.text || message.content}}
  </view>


  <!-- 留言图片 -->

  <view
    wx:if="{{message.images && message.images.length > 0}}"
    class="message-image-list"
  >

    <block
      wx:for="{{message.images}}"
      wx:key="*this"
    >

      <image
        class="message-image"
        src="{{item}}"
        mode="aspectFill"
      />

    </block>

  </view>

</view>


<!-- 留言不存在 -->

<view
  wx:if="{{!message}}"
  class="empty"
>
  暂无留言内容
</view>


<!-- 只有存在留言时才显示处理区域 -->

<block wx:if="{{message}}">


  <!-- 处理状态 -->

  <!-- 处理状态 -->

<view class="card">

<view class="card-title">
  处理状态
</view>


<view class="status-list">

  <view
    wx:for="{{statuses}}"
    wx:key="id"

    class="status-item {{currentStatus === item.id ? 'active' : ''}}"

    data-id="{{item.id}}"

    bindtap="selectStatus"
  >

    <text>
      {{item.name}}
    </text>

  </view>

</view>


<!-- 保存状态 -->

<button
  class="status-save-btn"
  bindtap="saveStatus"
>
  保存处理状态
</button>


<!-- 转为投票 -->

<button
  wx:if="{{currentStatus === 'accepted'}}"
  class="poll-btn"
  bindtap="createPoll"
>
  转为投票
</button>

</view>


  <!-- 回复方式 -->

  <view class="card">

    <view class="card-title">
      回复方式
    </view>


    <view class="type-list">

      <view
        wx:for="{{replyTypes}}"
        wx:key="id"

        class="type-item {{replyType === item.id ? 'active' : ''}}"

        data-id="{{item.id}}"

        bindtap="selectReplyType"
      >

        {{item.name}}

      </view>

    </view>

  </view>


  <!-- 回复内容 -->

  <view class="card">

    <view class="card-title">
      回复内容
    </view>


    <textarea

      class="textarea"

      placeholder="{{placeholder}}"

      maxlength="500"

      value="{{replyContent}}"

      bindinput="onReplyInput"

    ></textarea>


    <view class="word-count">

      {{replyContent.length}} / 500

    </view>

  </view>


  <!-- 快捷回复 -->

  <view class="card">

    <view class="card-title">
      快捷回复
    </view>


    <view class="quick-list">

      <view
        class="quick"

        data-text="感谢你的建议！我们会认真评估。"

        bindtap="useQuickReply"
      >
        感谢建议
      </view>


      <view
        class="quick"

        data-text="这个建议很不错，我们想进一步了解一下。"

        bindtap="useQuickReply"
      >
        继续了解
      </view>


      <view
        class="quick"

        data-text="这个建议我们已经记录，后续会公布结果。"

        bindtap="useQuickReply"
      >
        已记录
      </view>

    </view>

  </view>


  <!-- 发布 -->

  <view class="bottom">

    <button

      class="send-btn"

      bindtap="sendReply"

    >
      发布回复
    </button>

  </view>


</block>

</view>