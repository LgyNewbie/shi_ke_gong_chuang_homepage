page {
  background: #F7F5EF;
}

.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 160rpx;
  box-sizing: border-box;
}


/* 顶部 */

.header {
  padding: 18rpx 4rpx 26rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #173C34;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7C8A84;
}


/* 数量 */

.count-card {
  height: 90rpx;
  padding: 0 28rpx;

  background: #EEF7F3;
  border-radius: 22rpx;

  display: flex;
  align-items: center;
  gap: 10rpx;

  box-sizing: border-box;

  font-size: 25rpx;
  color: #63766E;
}

.count-number {
  margin-left: 6rpx;

  font-size: 38rpx;
  font-weight: 700;

  color: #1F6A57;
}


/* 菜品 */

.food-list {
  margin-top: 24rpx;
}

.food-card {
  display: flex;

  padding: 20rpx;
  margin-bottom: 18rpx;

  background: #FFFFFF;
  border-radius: 22rpx;

  box-sizing: border-box;
}

.food-image {
  width: 190rpx;
  height: 190rpx;

  border-radius: 18rpx;

  flex-shrink: 0;
}

.food-info {
  flex: 1;

  margin-left: 20rpx;

  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #173C34;
}

.food-desc {
  margin-top: 12rpx;

  font-size: 24rpx;
  line-height: 1.6;

  color: #7D8A84;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.food-bottom {
  margin-top: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 34rpx;
  font-weight: 700;

  color: #DF6A43;
}

.favorite-btn {
  width: 64rpx;
  height: 64rpx;

  border-radius: 50%;

  background: #FFF0EA;

  color: #DF6A43;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 34rpx;
}


/* 空状态 */

.empty {
  text-align: center;
  padding-top: 170rpx;
}

.empty-icon {
  font-size: 88rpx;
  color: #9DB4AA;
}

.empty-title {
  margin-top: 20rpx;

  font-size: 31rpx;
  font-weight: 600;

  color: #173C34;
}

.empty-text {
  margin-top: 12rpx;

  font-size: 24rpx;
  color: #9AA39F;
}

.go-menu-btn {
  width: 300rpx;

  margin-top: 34rpx;

  border-radius: 50rpx;

  background: #1F6A57;
  color: #FFFFFF;

  font-size: 28rpx;
}